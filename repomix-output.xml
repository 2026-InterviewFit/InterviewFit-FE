            </p>
          </div>

          <div className="flex gap-3 shrink-0 flex-wrap">
            {[
              { label: "누적 후기", value: "2,841", icon: <MessageCircle className="h-4 w-4" />, color: "text-blue-500" },
              { label: "이번 주 합격", value: "38명", icon: <Award className="h-4 w-4" />, color: "text-purple-500" },
