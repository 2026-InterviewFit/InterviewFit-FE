<file path="hooks/useInterviewCamera.ts">
// hooks/useInterviewCamera.ts

import {
  useCallback,
  useEffect,
  useRef,
  useState,
} from "react";

import {
  getInterviewReport,
  uploadAnswerVideo,
} from "@/lib/api";

import {
  fixWebmBlobDuration,
  getSupportedWebmMimeType,
} from "@/lib/mediaRecorder";


interface UseInterviewCameraProps {
  step: string;
  interviewId: number | null;
  startedUserId: number | null;
  jobRoleId: number | null;
  jobName?: string;
  currentQuestions: string[];
  questionTimestamps: number[];
  onExit: () => void;
}


export function useInterviewCamera({
  step,
  interviewId,
  startedUserId,
  jobRoleId,
  jobName,
  currentQuestions,
  questionTimestamps,
  onExit,
}: UseInterviewCameraProps) {
  const videoRef =
    useRef<HTMLVideoElement>(null);

  const streamRef =
    useRef<MediaStream | null>(null);

  /**
   * 면접 전체 영상 녹화용 MediaRecorder.
   *
   * 눈깜빡임 / 자세 / 전체 분석을 위해
   * 면접 시작부터 analyzing 직전까지 계속 녹화한다.
   */
  const mediaRecorderRef =
    useRef<MediaRecorder | null>(null);

  const chunksRef =
    useRef<Blob[]>([]);

  const recordStartTimeRef =
    useRef<number>(0);


  /**
   * =====================================================
   * 꼬리질문용 답변 음성 녹음
   * =====================================================
   *
   * 전체 영상 녹화와 별개로 같은 마이크 트랙을 사용해
   * 현재 질문의 답변 구간만 audio/webm Blob으로 만든다.
   *
   * 기본 질문 답변:
   * Blob -> STT -> 꼬리질문 생성
   *
   * 꼬리질문 답변:
   * Blob -> STT -> follow_up_answers 저장
   */
  const answerRecorderRef =
    useRef<MediaRecorder | null>(null);

  const answerChunksRef =
    useRef<Blob[]>([]);


  const pollIntervalRef =
    useRef<NodeJS.Timeout | null>(null);


  const [analysisProgress, setAnalysisProgress] =
    useState(1);

  const [analysisResult, setAnalysisResult] =
    useState<{ message?: string } | null>(null);

  const [analysisError, setAnalysisError] =
    useState("");


  const stopCamera =
    useCallback(() => {
      streamRef.current
        ?.getTracks()
        .forEach(
          (track) =>
            track.stop(),
        );

      streamRef.current = null;
    }, []);


  /**
   * 현재 질문 답변용 오디오 녹음 시작.
   *
   * 이미 녹음 중이면 중복 생성하지 않는다.
   */
  const startAnswerRecording =
    useCallback((): boolean => {
      const sourceStream =
        streamRef.current;


      if (!sourceStream) {
        console.warn(
          "[FollowUp STT] 카메라/마이크 스트림이 아직 준비되지 않았습니다.",
        );

        return false;
      }


      if (
        answerRecorderRef.current &&
        answerRecorderRef.current.state ===
          "recording"
      ) {
        return true;
      }


      const audioTracks =
        sourceStream.getAudioTracks();


      if (
        audioTracks.length === 0
      ) {
        console.warn(
          "[FollowUp STT] 사용할 수 있는 마이크 트랙이 없습니다.",
        );

        return false;
      }


      const audioStream =
        new MediaStream(
          audioTracks,
        );


      const mimeType =
        MediaRecorder.isTypeSupported(
          "audio/webm;codecs=opus",
        )
          ? "audio/webm;codecs=opus"
          : "audio/webm";


      const recorder =
        new MediaRecorder(
          audioStream,
          {
            mimeType,
          },
        );


      answerChunksRef.current = [];


      recorder.ondataavailable =
        (event) => {
          if (
            event.data.size > 0
          ) {
            answerChunksRef.current.push(
              event.data,
            );
          }
        };


      recorder.start(250);

      answerRecorderRef.current =
        recorder;


      console.log(
        "[FollowUp STT] 현재 질문 답변 오디오 녹음 시작",
      );


      return true;
    }, []);


  /**
   * 현재 질문 답변 녹음을 종료하고 audio/webm Blob을 반환한다.
   */
  const stopAnswerRecording =
    useCallback(async (): Promise<Blob> => {
      const recorder =
        answerRecorderRef.current;


      if (
        !recorder ||
        recorder.state !==
          "recording"
      ) {
        throw new Error(
          "현재 녹음 중인 답변 음성이 없습니다.",
        );
      }


      return new Promise<Blob>(
        (
          resolve,
          reject,
        ) => {
          recorder.onerror =
            () => {
              answerRecorderRef.current =
                null;

              reject(
                new Error(
                  "답변 음성 녹음 중 오류가 발생했습니다.",
                ),
              );
            };


          recorder.onstop =
            () => {
              const blob =
                new Blob(
                  answerChunksRef.current,
                  {
                    type:
                      recorder.mimeType ||
                      "audio/webm",
                  },
                );


              answerChunksRef.current = [];

              answerRecorderRef.current =
                null;


              if (
                blob.size === 0
              ) {
                reject(
                  new Error(
                    "녹음된 답변 음성 파일이 비어 있습니다.",
                  ),
                );

                return;
              }


              console.log(
                "[FollowUp STT] 답변 오디오 녹음 완료:",
                blob.size,
                "bytes",
              );


              resolve(blob);
            };


          recorder.stop();
        },
      );
    }, []);


  /**
   * 면접 중단 등으로 현재 답변 Blob이 필요하지 않을 때
   * 별도 답변 녹음을 정리한다.
   */
  const discardAnswerRecording =
    useCallback(() => {
      const recorder =
        answerRecorderRef.current;


      if (
        recorder &&
        recorder.state ===
          "recording"
      ) {
        recorder.onstop =
          () => {
            answerChunksRef.current = [];
            answerRecorderRef.current =
              null;
          };

        recorder.stop();
      }
    }, []);


  /**
   * 컴포넌트 언마운트 시 폴링 및 답변 녹음 정리.
   */
  useEffect(() => {
    return () => {
      if (
        pollIntervalRef.current
      ) {
        clearInterval(
          pollIntervalRef.current,
        );

        pollIntervalRef.current =
          null;
      }


      const recorder =
        answerRecorderRef.current;

      if (
        recorder &&
        recorder.state ===
          "recording"
      ) {
        recorder.stop();
      }
    };
  }, []);


  /**
   * 카메라 + 마이크 스트림 준비.
   */
  useEffect(() => {
    const startCamera =
      async () => {
        try {
          const mediaStream =
            await navigator.mediaDevices
              .getUserMedia({
                video: true,
                audio: true,
              });


          streamRef.current =
            mediaStream;


          if (
            videoRef.current
          ) {
            videoRef.current.srcObject =
              mediaStream;
          }

        } catch {
          alert(
            "카메라와 마이크 권한을 허용해주세요!",
          );

          onExit();
        }
      };


    void startCamera();


    return () => {
      stopCamera();
    };
  }, [
    onExit,
    stopCamera,
  ]);


  /**
   * =====================================================
   * 전체 영상 녹화 / 업로드 / 분석 폴링
   * =====================================================
   */
  useEffect(() => {
    if (
      step === "recording" &&
      streamRef.current &&
      !mediaRecorderRef.current
    ) {
      chunksRef.current = [];


      const mimeType =
        getSupportedWebmMimeType();


      const recorder =
        new MediaRecorder(
          streamRef.current,
          {
            mimeType,
          },
        );


      mediaRecorderRef.current =
        recorder;


      recorder.ondataavailable =
        (event) => {
          if (
            event.data.size > 0
          ) {
            chunksRef.current.push(
              event.data,
            );
          }
        };


      recordStartTimeRef.current =
        Date.now();


      recorder.start(1000);
    }


    if (
      step === "analyzing"
    ) {
      /**
       * 마지막 꼬리질문 답변 처리 후
       * 남아 있는 구간 녹음이 있으면 정리한다.
       */
      discardAnswerRecording();
    }


    if (
      step === "analyzing" &&
      mediaRecorderRef.current?.state ===
        "recording"
    ) {
      setAnalysisResult(null);
      setAnalysisError("");
      setAnalysisProgress(1);


      const recorder =
        mediaRecorderRef.current;


      recorder.onstop =
        async () => {
          try {
            const rawBlob =
              new Blob(
                chunksRef.current,
                {
                  type:
                    recorder.mimeType ||
                    "video/webm",
                },
              );


            if (
              rawBlob.size === 0
            ) {
              throw new Error(
                "녹화된 영상 파일이 비어 있습니다.",
              );
            }


            if (!interviewId) {
              throw new Error(
                "면접 세션 정보가 없습니다. 다시 시작해주세요.",
              );
            }


            setAnalysisProgress(15);


            const recordedDurationMs =
              Date.now() -
              recordStartTimeRef.current;


            /**
             * develop에서 사용하던 duration 보정 유틸을 유지한다.
             *
             * 녹화한 webm의 duration metadata를 복구해야
             * FastAPI / ffmpeg 쪽 전체 분석이 안정적으로 동작한다.
             */
            const blob =
              await fixWebmBlobDuration(
                rawBlob,
                recordedDurationMs,
              );


            setAnalysisProgress(30);


            const result =
              await uploadAnswerVideo({
                interviewId,
                file: blob,
                answerOrder: 1,
                questionText:
                  currentQuestions.join(
                    " | ",
                  ),
              });


            /**
             * 대시보드에서 최근 분석 기록을 찾기 위한 로컬 기록.
             */
            const historyItem = {
              interviewId,
              userId:
                startedUserId,
              jobRoleId,
              jobName:
                jobName ??
                "모의면접",
              answers: [
                {
                  answerId:
                    result.answerId,
                  answerOrder:
                    result.answerOrder,
                  analysisStatus:
                    result.analysisStatus,
                },
              ],
              questionTexts:
                currentQuestions,
              questionTimestamps,
              savedAt:
                new Date()
                  .toISOString(),
            };


            localStorage.setItem(
              "latestInterviewAnalysisJob",
              JSON.stringify(
                historyItem,
              ),
            );


            const previousHistory =
              JSON.parse(
                localStorage.getItem(
                  "interviewAnalysisHistory",
                ) || "[]",
              );


            localStorage.setItem(
              "interviewAnalysisHistory",
              JSON.stringify(
                [
                  historyItem,
                  ...previousHistory.filter(
                    (item: {
                      interviewId?: number;
                    }) =>
                      item.interviewId !==
                      interviewId,
                  ),
                ].slice(
                  0,
                  20,
                ),
              ),
            );


            setAnalysisProgress(40);


            /**
             * 백엔드의 비동기 eye / pose 분석이
             * 완료될 때까지 3초마다 report를 확인한다.
             */
            pollIntervalRef.current =
              setInterval(
                async () => {
                  try {
                    const report =
                      await getInterviewReport(
                        interviewId,
                      );


                    if (
                      report.analysisStatus ===
                      "DONE"
                    ) {
                      if (
                        pollIntervalRef.current
                      ) {
                        clearInterval(
                          pollIntervalRef.current,
                        );

                        pollIntervalRef.current =
                          null;
                      }


                      setAnalysisProgress(
                        100,
                      );


                      setAnalysisResult({
                        message:
                          "모든 AI 분석이 완료되었습니다. 결과를 확인해 보세요!",
                      });

                    } else if (
                      report.analysisStatus ===
                      "FAILED"
                    ) {
                      if (
                        pollIntervalRef.current
                      ) {
                        clearInterval(
                          pollIntervalRef.current,
                        );

                        pollIntervalRef.current =
                          null;
                      }


                      setAnalysisError(
                        "AI 분석 중 오류가 발생했습니다.",
                      );

                    } else {
                      /**
                       * RUNNING 동안에는 99%를 넘지 않도록
                       * 표시 진행률만 조금씩 증가시킨다.
                       */
                      setAnalysisProgress(
                        (prevProgress) =>
                          prevProgress < 98
                            ? prevProgress +
                              Math.floor(
                                Math.random() *
                                  3,
                              ) +
                              1
                            : 99,
                      );
                    }

                  } catch {
                    /**
                     * 폴링 도중 일시적인 네트워크 오류는
                     * 다음 주기에 다시 확인한다.
                     */
                  }
                },
                3000,
              );

          } catch (error) {
            setAnalysisError(
              error instanceof Error
                ? error.message
                : "업로드 중 오류가 발생했습니다.",
            );

          } finally {
            mediaRecorderRef.current =
              null;
          }
        };


      recorder.stop();


      if (
        streamRef.current
      ) {
        streamRef.current
          .getTracks()
          .forEach(
            (track) =>
              track.stop(),
          );

        streamRef.current =
          null;
      }
    }
  }, [
    step,
    currentQuestions,
    interviewId,
    jobRoleId,
    jobName,
    startedUserId,
    questionTimestamps,
    discardAnswerRecording,
  ]);


  return {
    videoRef,
    analysisProgress,
    analysisResult,
    analysisError,
    stopCamera,
    startAnswerRecording,
    stopAnswerRecording,
    discardAnswerRecording,
  };
}
</file>

<file path="hooks/useRoomConnection.ts">
"use client";

import { useCallback, useEffect, useMemo, useRef, useState } from "react";
import { Client } from "@stomp/stompjs";
import { useLocalParticipant, useParticipants } from "@livekit/components-react";
import SockJS from "sockjs-client";
import {
  getGroupParticipants,
  getGroupSession,
  setGroupReady,
} from "@/lib/groupInterviewApi";
import { getAuthUser } from "@/lib/auth";
import type {
  GroupInterviewEvent,
  GroupInterviewProgress,
  GroupParticipant,
} from "@/types/groupInterview";

const API_BASE_URL = process.env.NEXT_PUBLIC_API_BASE_URL ?? "http://localhost:8080";
const PARTICIPANT_EVENTS = new Set([
  "PARTICIPANT_JOINED",
  "PARTICIPANT_LEFT",
  "PARTICIPANT_READY",
  "PARTICIPANT_UNREADY",
]);

export interface RoomParticipant extends GroupParticipant {
  isMe?: boolean;
}

export function useRoomConnection(roomId: string) {
  const liveParticipants = useParticipants();
  const { localParticipant } = useLocalParticipant();
  const [apiParticipants, setApiParticipants] = useState<GroupParticipant[]>([]);
  const [progress, setProgress] = useState<GroupInterviewProgress | null>(null);
  const [lastEvent, setLastEvent] = useState<GroupInterviewEvent | null>(null);
  const [connectionError, setConnectionError] = useState("");
  const [isReadyUpdating, setIsReadyUpdating] = useState(false);
  const mountedRef = useRef(false);
  const progressRevisionRef = useRef(0);

  const loadParticipants = useCallback(async () => {
    const value = await getGroupParticipants(roomId);
    if (mountedRef.current) setApiParticipants(value);
  }, [roomId]);

  const loadProgress = useCallback(async () => {
    const requestRevision = ++progressRevisionRef.current;
    const value = await getGroupSession(roomId);
    if (!mountedRef.current || requestRevision !== progressRevisionRef.current) return;
    setProgress(value);
  }, [roomId]);

  useEffect(() => {
    let cancelled = false;
    mountedRef.current = true;
    const initialProgressRevision = ++progressRevisionRef.current;

    void Promise.all([getGroupParticipants(roomId), getGroupSession(roomId)])
      .then(([participantValue, progressValue]) => {
        if (cancelled) return;
        setApiParticipants(participantValue);
        if (initialProgressRevision === progressRevisionRef.current) {
          setProgress(progressValue);
        }
      })
      .catch((cause) => {
        if (!cancelled) {
          setConnectionError(cause instanceof Error ? cause.message : "면접방 상태를 불러오지 못했습니다.");
        }
      });

    const client = new Client({
      webSocketFactory: () => new SockJS(`${API_BASE_URL}/ws-interview`),
      reconnectDelay: 3000,
      onConnect: () => {
        if (cancelled) return;
        setConnectionError("");
        // 재연결 사이에 놓친 broadcast가 있어도 서버의 현재 세션으로 복구한다.
        void loadProgress();
        client.subscribe(`/topic/room/${roomId}`, (frame) => {
          if (cancelled) return;
          try {
            const event = JSON.parse(frame.body) as GroupInterviewEvent;
            setLastEvent(event);
            // 진행 상태는 이벤트명을 해석해 계산하지 않고 서버 payload를 그대로 쓴다.
            if (event.progress) {
              progressRevisionRef.current += 1;
              setProgress(event.progress);
            }
            if (PARTICIPANT_EVENTS.has(event.type)) void loadParticipants();
          } catch {
            setConnectionError("면접방 실시간 이벤트를 해석하지 못했습니다.");
          }
        });
      },
      onStompError: (frame) => {
        if (cancelled) return;
        setConnectionError(frame.headers.message || "면접방 실시간 연결에 실패했습니다.");
      },
      onWebSocketError: () => {
        if (cancelled) return;
        setConnectionError("면접방 실시간 연결이 끊겼습니다. 재연결 중입니다.");
      },
    });

    client.activate();
    return () => {
      cancelled = true;
      mountedRef.current = false;
      progressRevisionRef.current += 1;
      void client.deactivate();
    };
  }, [loadParticipants, loadProgress, roomId]);

  const participants = useMemo<RoomParticipant[]>(() => {
    const me = getAuthUser();
    return liveParticipants.map((participant) => {
      const api = apiParticipants.find((item) => item.userId === participant.identity);
      return {
        userId: participant.identity,
        nickname: participant.name || api?.nickname || "참가자",
        isHost: api?.isHost ?? false,
        isReady: api?.isReady ?? false,
        cameraOn: participant.isCameraEnabled,
        micOn: participant.isMicrophoneEnabled,
        isMe: participant.isLocal || participant.identity === String(me?.id ?? ""),
      };
    });
  }, [apiParticipants, liveParticipants]);

  const toggleReady = useCallback(async () => {
    if (isReadyUpdating) return;
    try {
      setIsReadyUpdating(true);
      setConnectionError("");
      const me = getAuthUser();
      const current = apiParticipants.find((participant) => participant.userId === String(me?.id));
      const updated = await setGroupReady(roomId, !current?.isReady);
      setApiParticipants((participantsValue) => participantsValue.map((participant) => (
        participant.userId === updated.userId ? updated : participant
      )));
    } catch (cause) {
      setConnectionError(cause instanceof Error ? cause.message : "준비 상태를 변경하지 못했습니다.");
    } finally {
      setIsReadyUpdating(false);
    }
  }, [apiParticipants, isReadyUpdating, roomId]);

  const toggleCamera = useCallback(
    () => void localParticipant.setCameraEnabled(!localParticipant.isCameraEnabled),
    [localParticipant],
  );
  const toggleMic = useCallback(
    () => void localParticipant.setMicrophoneEnabled(!localParticipant.isMicrophoneEnabled),
    [localParticipant],
  );

  const isAllReady = participants.length > 1 && participants.every((participant) => participant.isReady);

  return {
    participants,
    progress,
    lastEvent,
    connectionError,
    isReadyUpdating,
    toggleReady,
    toggleCamera,
    toggleMic,
    isAllReady,
  };
}
</file>

<file path="lib/groupInterviewApi.ts">
import { authFetch, readErrorMessage } from "@/lib/api";
import type {
  CreateRoomPayload,
  GroupInterviewAnswerAnalysis,
  GroupInterviewHistory,
  GroupInterviewMyAnswer,
  GroupParticipant,
  GroupInterviewProgress,
  GroupRoom,
  LiveKitCredentials,
  RoomStatus,
} from "@/types/groupInterview";

const API_BASE_URL = process.env.NEXT_PUBLIC_API_BASE_URL ?? "http://localhost:8080";
const GROUP_API = `${API_BASE_URL}/api/group-interviews`;

type JsonObject = Record<string, unknown>;

export class GroupInterviewApiError extends Error {
  constructor(public status: number, message: string) {
    super(message);
    this.name = "GroupInterviewApiError";
  }
}

async function unwrap(response: Response): Promise<unknown> {
  if (!response.ok) {
    throw new GroupInterviewApiError(response.status, await readErrorMessage(response));
  }
  if (response.status === 204) return undefined;
  const data = await response.json();
  if (data && typeof data === "object" && "data" in data) return (data as JsonObject).data;
  return data;
}

function text(value: unknown, fallback = ""): string {
  return typeof value === "string" ? value : fallback;
}

function number(value: unknown, fallback = 0): number {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
}

function roomStatus(raw: JsonObject, current: number, max: number): RoomStatus {
  const value = text(raw.status).toLowerCase();
  if (["live", "in_progress", "ongoing"].includes(value)) return "live";
  if (["finished", "completed", "closed"].includes(value)) return "finished";
  if (["full"].includes(value) || current >= max) return "full";
  if (current === max - 1) return "almostFull";
  return "recruiting";
}

function normalizeRoom(value: unknown): GroupRoom {
  const raw = (value ?? {}) as JsonObject;
  const jobRole = (raw.jobRole ?? {}) as JsonObject;
  const host = (raw.host ?? raw.hostUser ?? {}) as JsonObject;
  const id = number(raw.id ?? raw.roomId);
  const current = number(raw.currentParticipants ?? raw.participantCount ?? raw.currentParticipantCount);
  const max = number(raw.maxParticipants, 4);
  return {
    id,
    roomId: String(raw.id ?? raw.roomId ?? ""),
    title: text(raw.title),
    category: text(raw.category ?? jobRole.category, "기타"),
    role: text(raw.role ?? raw.jobRoleName ?? jobRole.name),
    jobRoleId: number(raw.jobRoleId ?? jobRole.id) || undefined,
    currentParticipants: current,
    maxParticipants: max,
    status: roomStatus(raw, current, max),
    startAt: text(raw.scheduledStartTime ?? raw.startAt),
    hostName: text(raw.hostName ?? host.name, "방장"),
  };
}

function normalizeParticipant(value: unknown): GroupParticipant {
  const raw = (value ?? {}) as JsonObject;
  const user = (raw.user ?? {}) as JsonObject;
  return {
    id: number(raw.id) || undefined,
    userId: String(raw.userId ?? user.id ?? raw.id ?? ""),
    nickname: text(raw.nickname ?? raw.userName ?? raw.name ?? user.name, "참가자"),
    isHost: Boolean(raw.isHost ?? raw.host),
    isReady: text(raw.status).toUpperCase() === "READY" || Boolean(raw.isReady ?? raw.ready),
    cameraOn: raw.cameraOn !== false,
    micOn: raw.micOn !== false,
  };
}

export async function getGroupRooms(): Promise<GroupRoom[]> {
  const data = await unwrap(await fetch(GROUP_API));
  const list = Array.isArray(data) ? data : ((data as JsonObject)?.content ?? []);
  return (Array.isArray(list) ? list : []).map(normalizeRoom);
}

export async function getGroupRoom(roomId: string): Promise<GroupRoom> {
  return normalizeRoom(await unwrap(await authFetch(`${GROUP_API}/${encodeURIComponent(roomId)}`)));
}

export async function getGroupParticipants(roomId: string): Promise<GroupParticipant[]> {
  const data = await unwrap(await authFetch(`${GROUP_API}/${encodeURIComponent(roomId)}/participants`));
  const list = Array.isArray(data) ? data : ((data as JsonObject)?.content ?? []);
  return (Array.isArray(list) ? list : []).map(normalizeParticipant);
}

export async function createGroupRoom(payload: CreateRoomPayload): Promise<GroupRoom> {
  const response = await authFetch(GROUP_API, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload),
  });
  return normalizeRoom(await unwrap(response));
}

export async function joinGroupRoom(roomId: string): Promise<void> {
  await unwrap(await authFetch(`${GROUP_API}/${encodeURIComponent(roomId)}/join`, { method: "POST" }));
}

export async function setGroupReady(roomId: string, ready: boolean): Promise<GroupParticipant> {
  const response = await authFetch(`${GROUP_API}/${encodeURIComponent(roomId)}/ready`, {
    method: ready ? "POST" : "DELETE",
  });
  return normalizeParticipant(await unwrap(response));
}

export async function leaveGroupRoom(roomId: string): Promise<void> {
  await unwrap(await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/participants/me`,
    { method: "DELETE" },
  ));
}

async function mutateSession(roomId: string, action: string): Promise<GroupInterviewProgress> {
  return (await unwrap(await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/${action}`,
    { method: "POST" },
  ))) as GroupInterviewProgress;
}

export function startGroupInterview(roomId: string) {
  return mutateSession(roomId, "start");
}

export function startGroupAnswer(roomId: string) {
  return mutateSession(roomId, "answer/start");
}

export function completeGroupAnswer(roomId: string) {
  return mutateSession(roomId, "answer-complete");
}

export async function uploadGroupAnswerVideo(
  roomId: string,
  answerId: number,
  blob: Blob,
): Promise<void> {
  const formData = new FormData();
  formData.append("file", blob, `group-answer-${answerId}.webm`);
  await unwrap(await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/answers/${answerId}/video`,
    {
      method: "POST",
      body: formData,
    },
  ));
}

export async function getGroupAnswerAnalysis(
  roomId: string,
  answerId: number,
): Promise<GroupInterviewAnswerAnalysis> {
  const value = (await unwrap(await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/answers/${answerId}/analysis`,
  ))) as JsonObject;
  return {
    ...value,
    answerId: number(value.answerId, answerId),
    status: text(value.status ?? value.analysisStatus) as GroupInterviewAnswerAnalysis["status"],
  } as GroupInterviewAnswerAnalysis;
}

export async function retryGroupAnswerAnalysis(roomId: string, answerId: number): Promise<void> {
  const response = await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/answers/${answerId}/analysis`,
    { method: "POST" },
  );
  if (!response.ok) await unwrap(response);
}

export async function getMyGroupInterviewHistory(): Promise<GroupInterviewHistory[]> {
  const data = await unwrap(await authFetch(`${GROUP_API}/me/history`));
  return Array.isArray(data) ? data as GroupInterviewHistory[] : [];
}

export async function getMyGroupInterviewAnswers(roomId: string): Promise<GroupInterviewMyAnswer[]> {
  const data = await unwrap(await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/answers/me`,
  ));
  return Array.isArray(data) ? data as GroupInterviewMyAnswer[] : [];
}

export function finishGroupInterview(roomId: string) {
  return mutateSession(roomId, "finish");
}

export async function getGroupSession(roomId: string): Promise<GroupInterviewProgress | null> {
  const response = await authFetch(`${GROUP_API}/${encodeURIComponent(roomId)}/session`);
  // 면접 시작 전에는 백엔드가 아직 세션이 없다는 의미로 400 또는 404를 반환한다.
  if (response.status === 400 || response.status === 404) return null;
  return (await unwrap(response)) as GroupInterviewProgress;
}

export async function getLiveKitCredentials(roomId: string): Promise<LiveKitCredentials> {
  const data = (await unwrap(await authFetch(
    `${GROUP_API}/${encodeURIComponent(roomId)}/livekit-token`,
    { method: "POST" },
  ))) as Partial<LiveKitCredentials>;
  if (!data?.url || !data.token) throw new Error("LiveKit 연결 정보가 올바르지 않습니다.");
  return { url: data.url, token: data.token };
}
