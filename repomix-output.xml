  /* 카드/표면은 순백색으로 두어 크림빛 배경 위로 살짝 떠 보이게 함 */
  --theme-surface: #FFFFFF;
  --theme-surface-glass: rgba(255, 255, 255, 0.7);
  --theme-border-glass: rgba(0, 0, 0, 0.04);
}

.dark {
