// hooks/useDashboard.ts
"use client";

import { useState, useEffect, useMemo } from "react";
import { getInterviewReport } from "@/lib/api";
import { loadInterviewHistory } from "@/lib/reportUtils";
import {
  loadPtGroupRecords,
  deletePtGroupRecord,
  withRoundLabels,
  seedDemoIfEmpty,
  type UnifiedRecord,
  type InterviewKind,
} from "@/lib/interviewHistoryStore";
import type { DashboardRecord } from "@/types";
import type { TabKey } from "@/components/dashboard/InterviewTabs";

export function useDashboard() {
  const [activeTab, setActiveTab] = useState<TabKey>("all");
  const [sortOrder, setSortOrder] = useState<"desc" | "asc">("desc");

  // ── 데이터 상태 ──
  const [singleRecords, setSingleRecords] = useState<DashboardRecord[]>([]);
  const [ptGroupRecords, setPtGroupRecords] = useState<UnifiedRecord[]>([]);
  const [checkedIds, setCheckedIds] = useState<string[]>([]);

  // 1. 1:1 면접 초기 로드 및 폴링
  useEffect(() => {
    const history = loadInterviewHistory();
    setSingleRecords(history);
    if (history.length === 0) return;

    let cancelled = false;
    Promise.all(
      history.map(async (record) => {
        try {
          const report = await getInterviewReport(record.interviewId);
          return { ...record, report };
        } catch (error) {
          return { ...record, reportError: error instanceof Error ? error.message : "조회 실패" };
        }
      })
    ).then((next) => { if (!cancelled) setSingleRecords(next); });
    
    return () => { cancelled = true; };
  }, []);

  useEffect(() => {
    if (singleRecords.length === 0) return;
    const hasRunning = singleRecords.some(r => !r.report?.analysisStatus || r.report.analysisStatus === "RUNNING" || r.report.analysisStatus === "UPLOADED");
    if (!hasRunning) return;
    
    const interval = window.setInterval(async () => {
      const next = await Promise.all(
        singleRecords.map(async (record) => {
          const status = record.report?.analysisStatus;
          if (status === "DONE" || status === "FAILED") return record;
          try {
            const report = await getInterviewReport(record.interviewId);
            return { ...record, report, reportError: undefined };
          } catch {
            return { ...record, reportError: "조회 실패" };
          }
        })
      );
      setSingleRecords(next);
    }, 5000);
    return () => window.clearInterval(interval);
  }, [singleRecords]);

  // 2. PT/그룹 초기 로드
  useEffect(() => {
    seedDemoIfEmpty();
    setPtGroupRecords(loadPtGroupRecords());
  }, []);

  // 3. 통계 및 정렬 연산
  const counts = useMemo(() => {
    return {
      all: singleRecords.length + ptGroupRecords.length,
      single: singleRecords.length,
      group: ptGroupRecords.filter(r => r.kind === "group").length,
      pt: ptGroupRecords.filter(r => r.kind === "pt").length,
    } as Record<TabKey, number>;
  }, [singleRecords, ptGroupRecords]);

  const sortedSingle = useMemo(() => {
    return [...singleRecords].sort((a, b) => {
      const t1 = new Date(a.savedAt ?? 0).getTime();
      const t2 = new Date(b.savedAt ?? 0).getTime();
      return sortOrder === "desc" ? t2 - t1 : t1 - t2;
    });
  }, [singleRecords, sortOrder]);

  const sortedPtGroup = useMemo(() => {
    const withRounds = withRoundLabels(ptGroupRecords);
    const filtered = activeTab === "all" ? withRounds : withRounds.filter(r => r.kind === activeTab);
    return filtered.sort((a, b) => {
      const t1 = new Date(a.savedAt).getTime();
      const t2 = new Date(b.savedAt).getTime();
      return sortOrder === "desc" ? t2 - t1 : t1 - t2;
    });
  }, [ptGroupRecords, activeTab, sortOrder]);

  // 4. 체크 및 삭제 액션
  const toggleCheck = (id: string) => {
    setCheckedIds(prev => prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]);
  };

  const handleBulkDelete = () => {
    if (!window.confirm(`선택한 ${checkedIds.length}개의 기록을 삭제하시겠습니까?`)) return;

    const remainingSingle = singleRecords.filter(r => !checkedIds.includes(String(r.interviewId)));
    if (remainingSingle.length !== singleRecords.length) {
      setSingleRecords(remainingSingle);
      localStorage.setItem("interviewAnalysisHistory", JSON.stringify(remainingSingle));
    }

    let ptGroupChanged = false;
    checkedIds.forEach(id => {
      const record = ptGroupRecords.find(r => r.id === id);
      if (record) {
        deletePtGroupRecord(record.kind, id);
        ptGroupChanged = true;
      }
    });
    
    if (ptGroupChanged) setPtGroupRecords(loadPtGroupRecords());
    setCheckedIds([]);
  };

  const deleteSingle = (id: number) => {
    const next = singleRecords.filter(r => r.interviewId !== id);
    setSingleRecords(next);
    localStorage.setItem("interviewAnalysisHistory", JSON.stringify(next));
  };

  const deletePtGroup = (kind: InterviewKind, id: string) => {
    deletePtGroupRecord(kind, id);
    setPtGroupRecords(loadPtGroupRecords());
  };

  return {
    activeTab, setActiveTab,
    sortOrder, setSortOrder,
    checkedIds, toggleCheck, handleBulkDelete,
    counts, sortedSingle, sortedPtGroup,
    showSingle: activeTab === "all" || activeTab === "single",
    showPtGroup: activeTab === "all" || activeTab === "group" || activeTab === "pt",
    deleteSingle, deletePtGroup,
    singleRecords // 회차 계산용
  };
}
</file>

<file path="hooks/useDeviceTest.ts">
import { useState, useEffect, useRef } from "react";

export function useDeviceTest() {
  const videoRef = useRef<HTMLVideoElement>(null);
  const [stream, setStream] = useState<MediaStream | null>(null);
  const [error, setError] = useState<string>("");

  useEffect(() => {
    let activeStream: MediaStream | null = null;

    async function setupDevice() {
      try {
        const mediaStream = await navigator.mediaDevices.getUserMedia({
          video: true,
          audio: true,
        });
        
        activeStream = mediaStream;
        setStream(mediaStream);

        // video 태그에 스트림 연결
        if (videoRef.current) {
          videoRef.current.srcObject = mediaStream;
        }
      } catch (err) {
        console.error("장치 연결 에러:", err);
        setError("카메라와 마이크 권한을 허용해주세요.");
      }
    }

    setupDevice();

    return () => {
      if (activeStream) {
        activeStream.getTracks().forEach((track) => track.stop());
      }
    };
  }, []);

  return { videoRef, stream, error };
}
</file>

<file path="hooks/usePtMedia.ts">
// hooks/usePtMedia.ts
"use client";

import { useCallback, useEffect, useRef, useState } from "react";

export function usePtMedia() {
  const videoNodeRef = useRef<HTMLVideoElement | null>(null);
  const streamRef = useRef<MediaStream | null>(null);

  const [cameraOn, setCameraOn] = useState(true);
  const [micOn, setMicOn] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [ready, setReady] = useState(false);

  // 💡 콜백 ref: video 엘리먼트가 (재)마운트될 때마다 실행되어 스트림을 재연결
  //    화면 전환(대기실→실전)으로 video가 새로 생겨도 카메라가 유지됨
  const videoRef = useCallback((node: HTMLVideoElement | null) => {
    videoNodeRef.current = node;
    if (node && streamRef.current) {
      node.srcObject = streamRef.current;
    }
  }, []);

  useEffect(() => {
    let cancelled = false;
    (async () => {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: true,
          audio: true,
        });
        if (cancelled) {
          stream.getTracks().forEach((t) => t.stop());
          return;
        }
        streamRef.current = stream;
        if (videoNodeRef.current) {
          videoNodeRef.current.srcObject = stream;
        }
        setReady(true);
      } catch (e) {
        setError("카메라·마이크 권한을 확인해주세요.");
        console.error(e);
      }
    })();

    return () => {
      cancelled = true;
      streamRef.current?.getTracks().forEach((t) => t.stop());
      streamRef.current = null;
    };
  }, []);

  // 스트림이 먼저 준비되고 video가 나중에 붙는 경우 대비
  useEffect(() => {
    if (ready && videoNodeRef.current && streamRef.current) {
      videoNodeRef.current.srcObject = streamRef.current;
    }
  }, [ready]);

  const toggleCamera = useCallback(() => {
    const stream = streamRef.current;
    if (!stream) return;
    const next = !cameraOn;
    stream.getVideoTracks().forEach((t) => (t.enabled = next));
    setCameraOn(next);
  }, [cameraOn]);

  const toggleMic = useCallback(() => {
    const stream = streamRef.current;
    if (!stream) return;
    const next = !micOn;
    stream.getAudioTracks().forEach((t) => (t.enabled = next));
    setMicOn(next);
  }, [micOn]);

  // 💡 슬라이스 녹화(MediaRecorder)에서 실제 스트림에 접근하기 위한 헬퍼
  const getStream = useCallback(() => streamRef.current, []);

  return { videoRef, cameraOn, micOn, error, ready, toggleCamera, toggleMic, getStream };
}
</file>

<file path="hooks/useRoomConnection.ts">
"use client";

import { useState, useEffect, useCallback } from "react";
import type { GroupParticipant } from "@/types/groupInterview";

export interface RoomParticipant extends GroupParticipant {
  isMe?: boolean;
}

export function useRoomConnection(roomId: string, userId: string, nickname: string) {
  const [participants, setParticipants] = useState<RoomParticipant[]>([]);

  useEffect(() => {
    // [0초] 나 자신 입장
    setParticipants([
      {
        userId: userId,
        nickname: nickname,
        isHost: true,
        isReady: false,
        cameraOn: true,
        micOn: true,
        isMe: true,
      },
    ]);

    // [3초] 가짜 참여자 1 입장 (캠 OFF, 마이크 ON)
    const t1 = setTimeout(() => {
      setParticipants((prev) => [
        ...prev,
        { userId: "user_2", nickname: "프론트장인", isHost: false, isReady: false, cameraOn: false, micOn: true },
      ]);
    }, 3000);

    // [7초] 가짜 참여자 2 입장 (캠 OFF, 마이크 OFF)
    const t2 = setTimeout(() => {
      setParticipants((prev) => [
        ...prev,
        { userId: "user_3", nickname: "스프링깎는노인", isHost: false, isReady: false, cameraOn: false, micOn: false },
      ]);
    }, 7000);

    // [9초] 가짜 참여자 1 '준비 완료'
    const t3 = setTimeout(() => {
      setParticipants((prev) =>
        prev.map((p) => (p.userId === "user_2" ? { ...p, isReady: true } : p))
      );
    }, 9000);

    // [12초] 마지막 유저 입장 (캠 ON, 마이크 ON, 들어오자마자 준비 완료)
    const t4 = setTimeout(() => {
      setParticipants((prev) => [
        ...prev,
        { userId: "user_4", nickname: "면접마스터", isHost: false, isReady: true, cameraOn: true, micOn: true },
      ]);
    }, 12000);

    // 💡 [15초] 가짜 참여자 2 (스프링깎는노인) '준비 완료'
    const t5 = setTimeout(() => {
      setParticipants((prev) =>
        prev.map((p) => (p.userId === "user_3" ? { ...p, isReady: true } : p))
      );
    }, 15000);

    // 컴포넌트 언마운트 시 타이머 정리
    return () => {
      clearTimeout(t1);
      clearTimeout(t2);
      clearTimeout(t3);
      clearTimeout(t4);
      clearTimeout(t5);
    };
  }, [roomId, userId, nickname]);

  // 내 준비 상태 토글 함수
  const toggleReady = useCallback(() => {
    setParticipants((prev) =>
      prev.map((p) => (p.isMe ? { ...p, isReady: !p.isReady } : p))
    );
  }, []);

  // 💡 참여자의 캠/마이크 UI 상태를 동기화하는 함수
  const toggleCamera = useCallback(() => {
    setParticipants((prev) => prev.map((p) => (p.isMe ? { ...p, cameraOn: !p.cameraOn } : p)));
  }, []);

  const toggleMic = useCallback(() => {
    setParticipants((prev) => prev.map((p) => (p.isMe ? { ...p, micOn: !p.micOn } : p)));
  }, []);

  // 참여자가 2명 이상이고, 모두 Ready 상태인지 확인
  const isAllReady = participants.length > 1 && participants.every((p) => p.isReady);

  return {
    participants,
    toggleReady,
    toggleCamera,
    toggleMic,
    isAllReady,
  };
}
