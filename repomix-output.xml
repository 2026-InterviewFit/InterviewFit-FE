  type EyeBlinkingAnalyzeResponse,
} from "@/lib/api";

type Step = "jobSelect" | "prepare" | "countdown" | "recording" | "confirmStop" | "analyzing";

// ── 직무 데이터 ───────────────────────────────────────────────
const JOB_CATEGORIES = [
  {
    label: "IT/개발",
