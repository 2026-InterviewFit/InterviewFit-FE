              <span className="w-10 shrink-0 text-right text-sm font-bold text-[#FFFDF5]">
                {user.score}
              </span>
              <ChevronRight className="h-4 w-4 shrink-0 text-[#95B1EE]/40 transition-transform group-hover:translate-x-0.5 group-hover:text-[#E7F1A8]" />
            </motion.button>
          ))}
        </div>
      </div>
    </div>
  );
}
