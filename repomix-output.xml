          <CommunitySidebar activeTab={activeTab} setActiveTab={setActiveTab} />
        </div>

        {/* 메인 영역 — 세 탭 모두 배너 없이 각자의 헤더로 진입 */}
        <div className="min-w-0 flex-1">
          {activeTab === "feed" && <FeedView />}
          {activeTab === "ranking" && <RankingView />}
          {activeTab === "wiki" && (
            <WikiView selectedQuestions={selectedQuestions} onToggleQuestion={toggleQuestion} />
          )}
        </div>
      </div>

      {/* 위키는 우측 사이드 레일이 담당하므로 데스크톱에선 플로팅 바 숨김.
          모바일에서는 플로팅 바로 시작 버튼 제공 */}
      {activeTab === "wiki" && (
        <div className="lg:hidden">
          <WikiFloatingBar selectedQuestions={selectedQuestions} />
        </div>
      )}
    </>
  );
}

export default function CommunityPage() {
  return (
    <main className="relative flex min-h-screen flex-col overflow-hidden bg-bg transition-colors duration-300 dark:bg-[#0f1729]">
      {/* 배경 블롭 (팔레트 톤) */}
      <div className="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-40">
        <div className="absolute -left-20 top-20 h-[500px] w-[500px] rounded-full bg-[#E7F1A8]/30 blur-[140px]" />
        <div className="absolute right-0 top-1/3 h-[600px] w-[600px] rounded-full bg-[#95B1EE]/40 blur-[160px]" />
      </div>

      <Navbar />
      <Suspense fallback={<div className="min-h-screen" />}>
        <CommunityContent />
      </Suspense>
      <Footer />
    </main>
  );
}
</file>

<file path="app/globals.css">
@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@theme {
  --color-bg: var(--theme-bg);
  --color-ink: var(--theme-ink);
  --color-navy: var(--theme-navy);
  --color-navy-dark: var(--theme-navy-dark);
  --color-muted: var(--theme-muted);
  --color-chip: var(--theme-chip);
  --color-line: var(--theme-line);

  --color-brand-soft: var(--theme-brand-soft);
  --color-brand-accent: var(--theme-brand-accent);

  --color-surface: var(--theme-surface);
  --color-surface-glass: var(--theme-surface-glass);
  --color-border-glass: var(--theme-border-glass);

  --font-sans: var(--font-satoshi), system-ui, sans-serif;
  --font-serif: var(--font-playfair), Georgia, serif;
}

:root {
  /* 🎨 Color Palette (04) 기준 색상 */
  /* #FFFDF5 Базовый белый = 기본 배경(가짜 흰색). 검정 글씨 + 크림 배경이 디폴트 */
  --theme-bg: #FFFDF5;
  --theme-ink: #171717;          /* 기본 검정 글씨 */
  --theme-navy: #364C84;         /* Темный синий = 메인 포인트 */
  --theme-navy-dark: #273761;    /* navy hover용 딥톤 */
  --theme-brand-soft: #95B1EE;   /* Светлый голубой = 서브 포인트 */
  --theme-brand-accent: #E7F1A8; /* Светлый зеленый = 강조(하이라이트) */
  --theme-muted: #64748B;
  --theme-chip: #E2E8F0;
  --theme-line: #CBD5E1;

  /* 카드/표면은 순백색으로 두어 크림빛 배경 위로 살짝 떠 보이게 함 */
  --theme-surface: #FFFFFF;
  --theme-surface-glass: rgba(255, 255, 255, 0.7);
  --theme-border-glass: rgba(0, 0, 0, 0.04);
}

.dark {
  --theme-bg: #0f1729;
  --theme-ink: #f8fafc;
  --theme-navy: #95B1EE;
  --theme-navy-dark: #b8cff8;
  --theme-brand-soft: #364C84;
  --theme-brand-accent: #2e3b1c;
  --theme-muted: #94a3b8;
  --theme-chip: #1e293b;
  --theme-line: #334155;

  --theme-surface: #1e293b;
  --theme-surface-glass: rgba(30, 41, 59, 0.7);
  --theme-border-glass: rgba(255, 255, 255, 0.05);
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
  transition: background-color 0.3s ease, color 0.3s ease;
}
