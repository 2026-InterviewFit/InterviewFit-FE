              Season 1 · This Week
            </span>
          </div>
          <span className="text-[11px] font-bold" style={{ color: `${CREAM}66` }}>
            TOP 10
          </span>
        </div>

        {/* 시상대 (Top 3) */}
        <div className="relative z-10 flex items-end justify-center gap-3 pt-6 md:gap-6">
