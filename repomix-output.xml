"use client";

import { motion, AnimatePresence } from "framer-motion";
import { useState, useEffect } from "react";
import { useCounter } from "@/hooks/useCounter";
import { LIVE_STATS } from "@/lib/constants"; // TESTIMONIALS는 에러나니까 뺐어!

const easeOut = [0.22, 1, 0.36, 1] as const;

// 🔥 일단 화면 띄워볼 수 있게 만든 가라 데이터 (나중에 백엔드 연동할 때 교체하면 됨!)
const MOCK_TESTIMONIALS = [
  { text: "인터뷰핏을 사용하고 자신감이 생겼어요.", user: "사용자 A님" },
  { text: "시선 처리 피드백이 정말 큰 도움이 됐습니다!", user: "취준생 B님" },
  { text: "덕분에 원하던 기업에 찰떡같이 합격했습니다!", user: "합격자 C님" },
];

// 큐브 회전 애니메이션 컴포넌트
function TestimonialCube({ testimonials }: { testimonials: typeof MOCK_TESTIMONIALS }) {
  const [currentIndex, setCurrentIndex] = useState(0);

  useEffect(() => {
    const timer = setInterval(() => {
      setCurrentIndex((prevIndex) => (prevIndex + 1) % testimonials.length);
    }, 5000); // 5초마다 다음 후기로 변경

    return () => clearInterval(timer);
  }, [testimonials.length]);

  return (
    <div className="relative h-20 w-full overflow-hidden flex items-center justify-center">
      <AnimatePresence mode="wait">
        <motion.div
          key={currentIndex}
          initial={{ opacity: 0, y: -20 }} // 위에서 등장
          animate={{ opacity: 1, y: 0 }}   // 중앙에 안착
          exit={{ opacity: 0, y: 20 }}     // 아래로 퇴장
          transition={{ duration: 0.8, ease: [0.4, 0, 0.2, 1] }} 
          className="flex flex-col items-center justify-center gap-1.5 px-4 absolute w-full"
        >
          {/* font-serif(궁서체 느낌) 빼고 폰트 깔끔하게! */}
          <p className="font-sans text-xl font-medium leading-relaxed text-white/90 text-center">
            "{testimonials[currentIndex].text}"
          </p>
          <p className="text-xs text-white/50">- {testimonials[currentIndex].user} -</p>
        </motion.div>
      </AnimatePresence>
    </div>
  );
}

export default function HeroCard() {
  const usersCount = useCounter({
    target: LIVE_STATS.users,
    duration: 1500,
    delay: 600,
  });
  
  const satisfaction = useCounter({
    target: LIVE_STATS.satisfaction,
    duration: 1500,
    delay: 800,
    decimals: 1,
  });

  return (
    <section className="mx-auto w-full max-w-[1280px] px-8 pb-20">
      <motion.div
        initial={{ opacity: 0, y: 24 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.9, delay: 0.5, ease: easeOut }}
        className="relative mx-auto h-[420px] w-full"
      >
        {/* 뒷판 */}
        <div className="absolute bottom-0 left-0 right-0 h-[280px] rounded-[28px] bg-navy/90" />

        {/* 메인 카드 */}
        <div className="absolute bottom-0 left-1/2 h-[420px] w-[78%] -translate-x-1/2 overflow-hidden rounded-[28px] border border-white/10 bg-navy-dark shadow-2xl">
          {/* 배경 그라데이션 */}
          <div className="absolute inset-0 bg-gradient-to-br from-[#3a4d7a] via-[#1f2c46] to-[#0f1729]" />

          {/* 광원 효과 */}
          <div className="absolute left-1/3 top-8 h-64 w-64 rounded-full bg-white/15 blur-3xl" />

          {/* 상단 라이브 인디케이터 */}
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ duration: 0.5, delay: 0.9 }}
            className="absolute top-8 left-1/2 z-10 flex -translate-x-1/2 items-center gap-2"
          >
            <span className="relative flex h-2 w-2">
              <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
              <span className="relative inline-flex h-2 w-2 rounded-full bg-emerald-400" />
            </span>
            <span className="text-xs font-medium uppercase tracking-[0.2em] text-white/70">
              Live
            </span>
          </motion.div>

          {/* 통계 3분할 (정확한 1:1:1 비율 + 중앙 정렬 + 자동 구분선) */}
          <div className="relative z-10 grid h-full grid-cols-3 items-center divide-x divide-white/10 px-8 pt-16">
            
            {/* 1. 사용자 수 */}
            <StatItem delay={0.8} label="활성 사용자">
              <div className="font-serif text-5xl font-medium tracking-tight text-white">
                {usersCount}
              </div>
              <div className="mt-2 text-xs text-white/50">현재 연습 중</div>
            </StatItem>

            {/* 2. 사용자 한줄 후기 (큐브 애니메이션 적용!) */}
            <StatItem delay={0.9} label="수강생 리얼 후기">
              <TestimonialCube testimonials={MOCK_TESTIMONIALS} />
            </StatItem>

            {/* 3. 만족도 */}
            <StatItem delay={1.0} label="사용자 만족도">
              <div className="flex items-baseline justify-center gap-1.5">
                <div className="font-serif text-5xl font-medium tracking-tight text-white">
                  {satisfaction}
                </div>
                <div className="text-2xl text-white/40">/5</div>
              </div>
              <div className="mt-2 text-xs text-white/50">★★★★★ 기준</div>
            </StatItem>

          </div>
        </div>
      </motion.div>
    </section>
  );
}

/* ─────────────────────────────────────────────
   재사용 컴포넌트
   ───────────────────────────────────────────── */

interface StatItemProps {
  children: React.ReactNode;
  label: string;
  delay: number;
}

function StatItem({ children, label, delay }: StatItemProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 12 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.7, delay, ease: easeOut }}
      className="flex flex-col items-center text-center px-4"
    >
      <div className="mb-4 text-[10px] font-medium uppercase tracking-[0.2em] text-white/40">
        {label}
      </div>
      {children}
    </motion.div>
  );
}
