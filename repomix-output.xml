// lib/interviewHistoryStore.ts
"use client";

import { MOCK_PT_REPORT } from "@/lib/ptInterviewData";

export type InterviewKind = "single" | "group" | "pt";

export interface UnifiedRecord {
  id: string;
  kind: InterviewKind;
  title: string;
  jobName: string;
  overallScore: number;
  savedAt: string;
  detail?: unknown;
}

const PT_HISTORY_KEY = "ptInterviewHistory";

// ── 저장 (PT/그룹만) ──
export function saveRecord(kind: "pt", record: Omit<UnifiedRecord, "kind">) {
  if (typeof window === "undefined") return;
  const prevRaw = localStorage.getItem(PT_HISTORY_KEY);
  let list: UnifiedRecord[] = [];
  try {
    if (prevRaw) {
      const parsed = JSON.parse(prevRaw);
      if (Array.isArray(parsed)) list = parsed;
    }
  } catch {}
  list.unshift({ ...record, kind });
  localStorage.setItem(PT_HISTORY_KEY, JSON.stringify(list));
}

function loadPtRecords(): UnifiedRecord[] {
  if (typeof window === "undefined") return [];
  const raw = localStorage.getItem(PT_HISTORY_KEY);
  if (!raw) return [];
  try {
    const parsed = JSON.parse(raw);
    if (!Array.isArray(parsed)) return [];
    return parsed.map((r: UnifiedRecord, idx: number) => ({
      id: String(r.id ?? `pt_${idx}`),
      kind: "pt",
      title: r.title ?? "저장된 면접 기록",
      jobName: r.jobName ?? "직무 미지정",
      overallScore: typeof r.overallScore === "number" ? r.overallScore : 0,
      savedAt: r.savedAt ?? new Date(0).toISOString(),
      detail: r.detail,
    }));
  } catch {
    return [];
  }
}

// ── PT + 그룹만 조회 (1:1은 기존 로직이 담당) ──
export function loadPtGroupRecords(): UnifiedRecord[] {
  // 그룹 기록은 백엔드 /me/history가 source of truth다. 이 저장소는 PT만 담당한다.
  const all = loadPtRecords();
  const seen = new Set<string>();
  const unique = all.filter((r) => (seen.has(r.id) ? false : (seen.add(r.id), true)));
  return unique.sort((a, b) => new Date(b.savedAt).getTime() - new Date(a.savedAt).getTime());
}

export function deletePtGroupRecord(id: string) {
  if (typeof window === "undefined") return;
  const raw = localStorage.getItem(PT_HISTORY_KEY);
  if (!raw) return;
  try {
    const list: UnifiedRecord[] = JSON.parse(raw);
    localStorage.setItem(PT_HISTORY_KEY, JSON.stringify(list.filter((r) => r.id !== id)));
  } catch {}
}

// ── 회차 라벨 (종류별로 오래된 순 1회차) ──
export function withRoundLabels(records: UnifiedRecord[]): (UnifiedRecord & { round: number; roundLabel: string })[] {
  const byKind: Record<string, UnifiedRecord[]> = {};
  records.forEach((r) => { (byKind[r.kind] ??= []).push(r); });
  const roundMap = new Map<string, number>();
  Object.values(byKind).forEach((list) => {
    [...list].sort((a, b) => new Date(a.savedAt).getTime() - new Date(b.savedAt).getTime())
      .forEach((r, i) => roundMap.set(r.id, i + 1));
  });
  return records.map((r) => {
    const round = roundMap.get(r.id) ?? 1;
    return { ...r, round, roundLabel: `${round}회차` };
  });
}

// ── 데모 시드 (PT/그룹만) ──
export function seedDemoIfEmpty() {
  if (typeof window === "undefined") return;
  if (localStorage.getItem("ptGroupDemoSeeded") === "1") return;
  const now = Date.now();
  const day = 86400000;

  if (!localStorage.getItem(PT_HISTORY_KEY)) {
    localStorage.setItem(PT_HISTORY_KEY, JSON.stringify([
      { id: "pt_seed_3", kind: "pt", title: "데이터 파이프라인 설계 발표", jobName: "데이터분석", overallScore: 88, savedAt: new Date(now - day).toISOString(), detail: MOCK_PT_REPORT },
      { id: "pt_seed_2", kind: "pt", title: "신규 서비스 제안 발표", jobName: "백엔드", overallScore: 79, savedAt: new Date(now - day * 5).toISOString(), detail: MOCK_PT_REPORT },
      { id: "pt_seed_1", kind: "pt", title: "AI 모의면접 플랫폼 소개", jobName: "프론트엔드", overallScore: 84, savedAt: new Date(now - day * 12).toISOString(), detail: MOCK_PT_REPORT },
    ]));
  }
  
  localStorage.setItem("ptGroupDemoSeeded", "1");
}
</file>

<file path="store/usePtInterviewStore.ts">
import { create } from "zustand";

import type {
  DocumentAnalysisStatus,
  Slide,
  DocumentSummary,
  PtQuestion,
  PtInterviewMeta,
} from "@/types/ptInterview";

import {
  createPtInterview,
  uploadPtDocument,
  getPtDocument,
} from "@/lib/api";

interface CreateForm {
  job: string;
  topic: string;
  instruction: string;
  prepMinutes: number;
  limitMinutes: number;
  file: File | null;
}

interface PtState {
  form: CreateForm;
  meta: PtInterviewMeta | null;

  analysisStatus: DocumentAnalysisStatus;
  analysisProgress: number;

  slides: Slide[];
  docSummary: DocumentSummary | null;

  currentSlideIdx: number;

  questions: PtQuestion[];
  currentQuestionIdx: number;

  isCreating: boolean;
  isUploading: boolean;
  isLoadingDocument: boolean;

  error: string | null;
}

interface PtActions {
  setForm: (patch: Partial<CreateForm>) => void;
  resetForm: () => void;

  createInterview: (interviewId: number) => Promise<number>;
  uploadDocument: (ptInterviewId: number) => Promise<void>;
  fetchDocument: (ptInterviewId: number) => Promise<void>;

  setCurrentSlideIdx: (index: number) => void;
  nextSlide: () => void;
  prevSlide: () => void;

  setQuestions: (questions: PtQuestion[]) => void;
  setCurrentQuestionIdx: (
    value: number | ((previous: number) => number)
  ) => void;

  clearError: () => void;
  reset: () => void;
}

const initialForm: CreateForm = {
  job: "백엔드",
  topic: "",
  instruction: "",
  prepMinutes: 3,
  limitMinutes: 5,
  file: null,
};

const initialState: PtState = {
  form: initialForm,
  meta: null,

  analysisStatus: "UPLOADED",
  analysisProgress: 0,

  slides: [],
  docSummary: null,

  currentSlideIdx: 0,

  questions: [],
  currentQuestionIdx: 0,

  isCreating: false,
  isUploading: false,
  isLoadingDocument: false,

  error: null,
};

function normalizeAnalysisStatus(
  status?: string | null
): DocumentAnalysisStatus {
  switch (status?.toUpperCase()) {
    case "UPLOADED":
      return "UPLOADED";

    case "EXTRACTING":
    case "PROCESSING":
      return "EXTRACTING";

    case "ANALYZING":
      return "ANALYZING";

    case "DONE":
    case "COMPLETED":
    case "SUCCESS":
      return "DONE";

    case "FAILED":
    case "ERROR":
      return "FAILED";

    default:
      return "UPLOADED";
  }
}

function getAnalysisProgress(status: DocumentAnalysisStatus): number {
  switch (status) {
    case "UPLOADED":
      return 10;

    case "EXTRACTING":
      return 40;

    case "ANALYZING":
      return 75;

    case "DONE":
      return 100;

    case "FAILED":
      return 0;
  }
}

function getErrorMessage(error: unknown, defaultMessage: string): string {
  return error instanceof Error ? error.message : defaultMessage;
}

export const usePtInterviewStore = create<PtState & PtActions>(
  (set, get) => ({
    ...initialState,

    setForm: (patch) =>
      set((state) => ({
        form: {
          ...state.form,
          ...patch,
        },
      })),

    resetForm: () =>
      set({
        form: {
          ...initialForm,
        },
      }),

    createInterview: async (interviewId) => {
      const { form } = get();

      if (!interviewId || interviewId <= 0) {
        throw new Error("유효한 면접 ID가 필요합니다.");
      }

      if (!form.topic.trim()) {
        throw new Error("발표 주제를 입력해 주세요.");
      }

      if (!form.file) {
        throw new Error("발표 자료를 선택해 주세요.");
      }

      set({
        isCreating: true,
        error: null,
      });

      try {
        const response = await createPtInterview({
          interviewId,
          topic: form.topic.trim(),
          instruction: form.instruction.trim(),
          preparationSeconds: form.prepMinutes * 60,
          presentationSeconds: form.limitMinutes * 60,
        });

        const status = normalizeAnalysisStatus(response.status);

        const meta: PtInterviewMeta = {
          ptInterviewId: response.id,
          job: form.job,
          topic: response.topic,
          instruction: response.instruction,
          prepSeconds: response.preparationSeconds,
          limitSeconds: response.presentationSeconds,
          fileName: form.file.name,
          fileSize: form.file.size,
          fileType: form.file.type,
          status,
        };

        set({
          meta,
          analysisStatus: status,
          analysisProgress: 0,
          slides: [],
          docSummary: null,
          currentSlideIdx: 0,
          questions: [],
          currentQuestionIdx: 0,
        });

        return response.id;
      } catch (error) {
        const message = getErrorMessage(
          error,
          "PT 면접 생성에 실패했습니다."
        );

        set({ error: message });
        throw error;
      } finally {
        set({ isCreating: false });
      }
    },

    uploadDocument: async (ptInterviewId) => {
      const { form } = get();

      if (!ptInterviewId || ptInterviewId <= 0) {
        throw new Error("유효한 PT 면접 ID가 필요합니다.");
      }

      if (!form.file) {
        throw new Error("업로드할 발표 자료가 없습니다.");
      }

      set({
        isUploading: true,
        error: null,
        analysisStatus: "UPLOADED",
        analysisProgress: 10,
      });

      try {
        const response = await uploadPtDocument(
          ptInterviewId,
          form.file
        );

        const status = normalizeAnalysisStatus(
          response.analysisStatus
        );

        set((state) => ({
          analysisStatus: status,
          analysisProgress: getAnalysisProgress(status),

          meta: state.meta
            ? {
                ...state.meta,
                ptInterviewId: response.ptInterviewId,
                fileName: response.originalFileName,
                fileSize: form.file?.size ?? state.meta.fileSize,
                fileType: form.file?.type ?? state.meta.fileType,
                status,
              }
            : null,
        }));
      } catch (error) {
        const message = getErrorMessage(
          error,
          "PT 발표 자료 업로드에 실패했습니다."
        );

        set({
          error: message,
          analysisStatus: "FAILED",
          analysisProgress: 0,
        });

        throw error;
      } finally {
        set({ isUploading: false });
      }
    },

    fetchDocument: async (ptInterviewId) => {
      if (!ptInterviewId || ptInterviewId <= 0) {
        throw new Error("유효한 PT 면접 ID가 필요합니다.");
      }

      set({
        isLoadingDocument: true,
        error: null,
      });

      try {
        const response = await getPtDocument(ptInterviewId);

        const status = normalizeAnalysisStatus(
          response.analysisStatus
        );

        const slides: Slide[] = response.slides.map((slide) => ({
          slideNumber: slide.slideNumber,
          title: slide.title ?? "",
          body: slide.extractedText ?? "",
          aiSummary: slide.summary ?? "",
        }));

        set((state) => ({
          analysisStatus: status,
          analysisProgress: getAnalysisProgress(status),
          slides,
          docSummary: null,
          currentSlideIdx: 0,

          meta: state.meta
            ? {
                ...state.meta,
                ptInterviewId: response.ptInterviewId,
                fileName: response.originalFileName,
                fileSize: response.fileSize,
                fileType: response.contentType,
                status,
              }
            : null,
        }));
      } catch (error) {
        const message = getErrorMessage(
          error,
          "PT 발표 자료 조회에 실패했습니다."
        );

        set({
          error: message,
          analysisStatus: "FAILED",
          analysisProgress: 0,
        });

        throw error;
      } finally {
        set({ isLoadingDocument: false });
      }
    },

    setCurrentSlideIdx: (index) =>
      set((state) => ({
        currentSlideIdx: Math.max(
          0,
          Math.min(index, Math.max(state.slides.length - 1, 0))
        ),
      })),

    nextSlide: () =>
      set((state) => ({
        currentSlideIdx: Math.min(
          state.currentSlideIdx + 1,
          Math.max(state.slides.length - 1, 0)
        ),
      })),

    prevSlide: () =>
      set((state) => ({
        currentSlideIdx: Math.max(state.currentSlideIdx - 1, 0),
      })),

    setQuestions: (questions) =>
      set({
        questions,
        currentQuestionIdx: 0,
      }),

    setCurrentQuestionIdx: (value) =>
      set((state) => ({
        currentQuestionIdx:
          typeof value === "function"
            ? value(state.currentQuestionIdx)
            : value,
      })),

    clearError: () => set({ error: null }),

    reset: () =>
      set({
        ...initialState,
        form: {
          ...initialForm,
        },
      }),
  })
);
</file>

