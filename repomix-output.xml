                      {selectedCategory} · {selectedJobName}
                    </span>
                  </div>
                  <h2 className="text-lg font-bold text-navy mt-1 leading-snug">
                    {currentQuestionText}
                  </h2>
                </motion.div>
              )}
            </AnimatePresence>
          </div>

          <div className="relative flex flex-1 items-center justify-center">
            {step === "prepare" && (
              <motion.div
                initial={{ opacity: 0, scale: 0.95 }}
