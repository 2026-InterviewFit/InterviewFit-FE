<file path="components/group-interview/lobby/RoomCard.tsx">
// components/group-interview/lobby/RoomCard.tsx
"use client";

import { motion } from "framer-motion";
import { Users, Clock, Crown, ChevronRight } from "lucide-react";
import type { GroupRoom } from "@/types/groupInterview";
import { statusMeta, formatStartTime } from "@/lib/groupInterviewData";
import { PALETTE } from "@/lib/communityData";

interface RoomCardProps {
  room: GroupRoom;
  index: number;
  onJoin: (roomId: string) => void;
}

export default function RoomCard({ room, index, onJoin }: RoomCardProps) {
  const meta = statusMeta(room.status);
  const isFull = room.currentParticipants >= room.maxParticipants;
  const joinable = room.status === "recruiting" || room.status === "almostFull";
  const fillPct = Math.min((room.currentParticipants / room.maxParticipants) * 100, 100);

  const buttonLabel =
    room.status === "full"
      ? "모집 완료됨"
      : room.status === "live"
      ? "면접 진행중"
      : room.status === "finished"
      ? "종료된 방"
      : "입장하기";

  return (
    <motion.article
      initial={{ opacity: 0, y: 12 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ delay: (index % 8) * 0.04 }}
      className="flex flex-col rounded-[20px] border border-line bg-surface p-5 shadow-sm transition-shadow hover:shadow-md"
    >
      <div className="mb-3 flex items-start justify-between gap-3">
        <div className="min-w-0">
          <div className="mb-1.5 flex flex-wrap items-center gap-1.5">
            <span className="rounded-md bg-chip px-2 py-0.5 text-[11px] font-bold text-ink">
              {room.category === "IT/개발" ? "IT · 개발" : room.category}
            </span>
            {room.role && (
              <span
                className="rounded-md px-2 py-0.5 text-[11px] font-bold"
                style={{ backgroundColor: "rgba(149,177,238,0.18)", color: PALETTE.navy }}
              >
                {room.role}
              </span>
            )}
          </div>
          <h3 className="truncate text-base font-bold text-ink">{room.title}</h3>
        </div>

        <span
          className="flex shrink-0 items-center gap-1 rounded-full px-2.5 py-1 text-[11px] font-bold"
          style={{ backgroundColor: meta.bg, color: meta.fg }}
        >
          <span className="h-1.5 w-1.5 rounded-full" style={{ backgroundColor: meta.dot }} />
          {meta.label}
        </span>
      </div>

      <div className="flex items-center gap-1.5 text-[11px] font-medium text-muted">
        <Crown className="h-3 w-3" style={{ color: PALETTE.lime }} /> {room.hostName}
        <span className="text-line">·</span>
        <Clock className="h-3 w-3" /> {formatStartTime(room.startAt)}
      </div>

      {/* 인원 게이지 */}
      <div className="mb-4 mt-3">
        <div className="mb-1.5 flex items-center justify-between text-[11px] font-bold">
          <span className="flex items-center gap-1 text-muted">
            <Users className="h-3.5 w-3.5" /> 참여 인원
          </span>
          <span className="text-navy">
            {room.currentParticipants}/{room.maxParticipants}명
          </span>
        </div>
        <div className="h-1.5 w-full overflow-hidden rounded-full bg-chip">
          <div
            className="h-full rounded-full transition-all"
            style={{ width: `${fillPct}%`, backgroundColor: isFull ? PALETTE.navy : PALETTE.sky }}
          />
        </div>
      </div>

      <button
        onClick={() => onJoin(room.roomId)}
        disabled={!joinable}
        className={`mt-auto flex items-center justify-center gap-1.5 rounded-xl py-3 text-sm font-bold transition-all ${
          joinable
            ? "bg-navy text-white shadow-sm hover:bg-navy-dark hover:-translate-y-0.5"
            : "cursor-not-allowed bg-chip text-muted"
        }`}
      >
        {buttonLabel}
        {joinable && <ChevronRight className="h-4 w-4" />}
      </button>
    </motion.article>
  );
}
</file>

<file path="components/group-interview/room/GroupAnalyzing.tsx">
"use client";

import { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { CheckCircle2, Lightbulb } from "lucide-react";

const ANALYZE_STEPS = [
  "발언 슬라이스 취합",
  "음성 및 발화 분석",
  "시선·자세 분석",
  "답변 내용 분석",
  "종합 리포트 생성",
];

const LOADING_TIPS = [
  { category: "💡 면접 꿀팁", text: "그룹 면접에서는 내 차례가 아닐 때의 경청 태도도 평가 요소가 됩니다." },
  { category: "🗣️ 답변 노하우", text: "앞 지원자와 답변이 겹칠 땐 '덧붙이자면' 으로 시작해 차별점을 만드세요." },
  { category: "👀 시선 처리", text: "카메라 렌즈를 가끔 응시하면 면접관과 눈을 맞추는 효과를 줄 수 있어요." },
];

interface GroupAnalyzingProps {
  onDone: () => void;
}

export default function GroupAnalyzing({ onDone }: GroupAnalyzingProps) {
  const [progress, setProgress] = useState(4);
  const [done, setDone] = useState(false);
  const [tipIdx, setTipIdx] = useState(0);

  useEffect(() => {
    const t = setInterval(() => {
      setProgress((p) => {
        const next = Math.min(p + Math.floor(Math.random() * 6) + 3, 100);
        if (next >= 100) {
          clearInterval(t);
          setDone(true);
        }
        return next;
      });
    }, 500);
    return () => clearInterval(t);
  }, []);

  useEffect(() => {
    const tipTimer = setInterval(() => setTipIdx((i) => (i + 1) % LOADING_TIPS.length), 5000);
    return () => clearInterval(tipTimer);
  }, []);

  const activeStep = Math.min(
    Math.floor((progress / 100) * ANALYZE_STEPS.length),
    ANALYZE_STEPS.length - 1
  );

  return (
    <main className="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-bg p-8 transition-colors duration-300 dark:bg-[#0f1729]">
      {/* 밝은 블롭 배경 (랜딩/대기실과 동일 톤) */}
      <div className="pointer-events-none absolute inset-0 z-0 overflow-hidden opacity-50 dark:opacity-30">
        <div className="absolute -top-40 -left-20 h-[650px] w-[650px] rounded-full bg-[#E7F1A8]/40 blur-[130px]" />
        <div className="absolute top-10 -right-20 h-[750px] w-[750px] rounded-full bg-[#95B1EE]/50 blur-[150px]" />
      </div>

      <div className="relative z-10 w-full max-w-lg text-center">
        {/* 진행 원 */}
        <div className="relative mx-auto mb-8 flex h-28 w-28 items-center justify-center">
          <div className="absolute inset-0 rounded-full border-4 border-black/[0.04] dark:border-white/[0.06]" />
          {!done ? (
            <>
              <div className="absolute inset-0 animate-[spin_2s_linear_infinite] rounded-full border-4 border-transparent border-t-navy" />
              <span className="font-serif text-xl font-bold text-navy dark:text-white">{progress}%</span>
            </>
          ) : (
            <CheckCircle2 className="h-12 w-12 text-emerald-500" />
          )}
        </div>

        <h2 className="text-2xl font-bold tracking-tight text-navy dark:text-white">
          {done ? "그룹 면접 분석 완료!" : "그룹 면접을 분석하고 있습니다"}
        </h2>
        <p className="mt-2 text-sm font-medium text-muted">
          {done
            ? "결과가 대시보드에 저장되었습니다."
            : "각 지원자의 발언과 비언어적 요소를 분석하고 있어요."}
        </p>

        {!done ? (
          <>
            {/* 단계 체크리스트 */}
            <div className="mt-8 flex flex-col gap-2.5 rounded-[24px] border border-line bg-surface p-6 text-left shadow-sm dark:bg-[#1e293b] dark:border-white/10">
              {ANALYZE_STEPS.map((step, i) => {
                const stepDone = i < activeStep;
                const current = i === activeStep;
                return (
                  <motion.div
                    key={step}
                    initial={{ opacity: 0, x: -8 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ delay: i * 0.05 }}
                    className="flex items-center gap-3"
                  >
                    <div
                      className={`flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold ${
                        stepDone
                          ? "bg-navy text-white"
                          : current
                          ? "bg-brand-soft/25 text-navy"
                          : "bg-chip text-muted"
                      }`}
                    >
                      {stepDone ? (
                        <CheckCircle2 className="h-3.5 w-3.5" />
                      ) : current ? (
                        <span className="inline-block h-3.5 w-3.5 animate-[spin_1s_linear_infinite] rounded-full border-2 border-current border-t-transparent" />
                      ) : (
                        i + 1
                      )}
                    </div>
                    <span className={`text-sm font-bold ${stepDone || current ? "text-ink" : "text-muted"}`}>
                      {step}
                    </span>
                  </motion.div>
                );
              })}
            </div>

            {/* 로딩 팁 */}
            <div className="mt-6 flex min-h-[110px] flex-col items-center justify-center rounded-[24px] border border-line bg-surface/70 p-6 shadow-sm backdrop-blur-md dark:bg-[#1e293b]/70 dark:border-white/10">
              <div className="mb-3 flex items-center gap-1.5 text-navy dark:text-brand-soft opacity-80">
                <Lightbulb className="h-4 w-4" />
                <span className="text-[11px] font-bold uppercase tracking-widest">Take a break</span>
              </div>
              <AnimatePresence mode="wait">
                <motion.div
                  key={tipIdx}
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: -10 }}
                  className="flex flex-col items-center gap-2"
                >
                  <span className="rounded-full bg-brand-soft/20 px-3 py-1 text-xs font-bold text-navy">
                    {LOADING_TIPS[tipIdx].category}
                  </span>
                  <p className="max-w-sm break-keep text-sm font-semibold leading-relaxed text-ink dark:text-gray-200">
                    {LOADING_TIPS[tipIdx].text}
                  </p>
                </motion.div>
              </AnimatePresence>
            </div>
          </>
        ) : (
          <button
            onClick={onDone}
            className="mx-auto mt-8 flex items-center gap-2 rounded-full bg-navy px-10 py-4 text-sm font-bold text-white shadow-lg transition-transform hover:scale-105"
          >
            대시보드에서 결과 확인하기
          </button>
        )}
      </div>
    </main>
  );
}
</file>

<file path="components/group-interview/room/ParticipantGrid.tsx">
"use client";

import { motion, AnimatePresence } from "framer-motion";
import { Mic, MicOff, Video, VideoOff, CheckCircle2, Radio } from "lucide-react";
import type { RoomParticipant } from "@/hooks/useRoomConnection";

const getAvatarColor = (name?: string) => {
  if (!name) return { bg: "#364C84", fg: "#FFFDF5" };
  const colors = [
    { bg: "#364C84", fg: "#FFFDF5" },
    { bg: "#95B1EE", fg: "#273761" },
    { bg: "#E7F1A8", fg: "#3F4A1B" },
    { bg: "#64748B", fg: "#F8FAFC" },
  ];
  const sum = name.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0);
  return colors[sum % colors.length];
};

interface ParticipantGridProps {
  participants: RoomParticipant[];
  myVideoStream?: React.Ref<HTMLVideoElement>;
  activeSpeakerId?: string;
}

export default function ParticipantGrid({ participants, myVideoStream, activeSpeakerId }: ParticipantGridProps) {
  return (
    // 💡 변경됨: h-fit 대신 flex-1 min-h-0 h-full 적용, sm:grid-rows-2 추가로 세로 2줄 강제 배분
    <div className="grid grid-cols-1 sm:grid-cols-2 sm:grid-rows-2 gap-3 md:gap-4 w-full max-w-5xl mx-auto flex-1 min-h-0 h-full">
      <AnimatePresence>
        {participants.map((p) => {
          const avatar = getAvatarColor(p.nickname);
          const displayName = p.nickname || "익명";
          const isSpeaking = !!activeSpeakerId && p.userId === activeSpeakerId;

          return (
            <motion.div
              key={p.userId}
              initial={{ opacity: 0, scale: 0.95 }}
              animate={{ opacity: 1, scale: 1 }}
              exit={{ opacity: 0, scale: 0.95 }}
              transition={{ duration: 0.4 }}
              // 💡 변경됨: aspect-video 제거 -> w-full h-full 적용하여 그리드 칸에 맞게 자동 리사이징
              className={`relative w-full h-full min-h-[160px] overflow-hidden rounded-[20px] md:rounded-[24px] bg-[#111827] shadow-lg transition-all duration-300 ${
                isSpeaking
                  ? "border-2 border-amber-400 shadow-[0_0_28px_rgba(251,191,36,0.45)]"
                  : p.isReady
                  ? "border-2 border-blue-500 shadow-[0_0_20px_rgba(59,130,246,0.3)]"
                  : "border-2 border-transparent dark:border-white/5"
              }`}
            >
              {p.isMe && myVideoStream && (
                <video
                  ref={myVideoStream}
                  autoPlay
                  playsInline
                  muted
                  className={`absolute inset-0 h-full w-full object-cover -scale-x-100 transition-opacity duration-300 ${
                    p.cameraOn ? "opacity-100" : "opacity-0"
                  }`}
                />
              )}

              {(!p.isMe && p.cameraOn) && (
                <div className="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-[#1e293b] to-[#0f1729]">
                  <span className="text-white/10 text-sm font-medium tracking-widest uppercase">Video Stream</span>
                </div>
              )}

              {!p.cameraOn && (
                <div className="absolute inset-0 flex items-center justify-center bg-[#111827]/80 backdrop-blur-sm z-10">
                  <div
                    className="flex h-16 w-16 md:h-20 md:w-20 items-center justify-center rounded-full text-xl md:text-2xl font-bold shadow-2xl"
                    style={{ backgroundColor: avatar.bg, color: avatar.fg }}
                  >
                    {displayName[0]}
                  </div>
                </div>
              )}

              {isSpeaking && (
                <div className="absolute left-3 top-3 md:left-4 md:top-4 z-30 flex items-center gap-1.5 rounded-full bg-amber-400/90 px-3 py-1 text-[11px] font-bold text-[#3F2D00] shadow-lg backdrop-blur-sm">
                  <Radio className="h-3 w-3 animate-pulse" /> 발언 중
                </div>
              )}

              <div className="absolute inset-x-0 bottom-0 flex items-center justify-between bg-gradient-to-t from-black/90 via-black/40 to-transparent px-3 pb-3 pt-12 md:px-5 md:pb-4 md:pt-16 z-20">
                <div className="flex items-center gap-2 md:gap-3">
                  <div className="flex gap-1.5 p-1 md:p-1.5 rounded-lg bg-black/40 backdrop-blur-md">
                    {p.micOn ? <Mic className="h-3 w-3 md:h-3.5 md:w-3.5 text-white" /> : <MicOff className="h-3 w-3 md:h-3.5 md:w-3.5 text-red-400" />}
                    {p.cameraOn ? <Video className="h-3 w-3 md:h-3.5 md:w-3.5 text-white" /> : <VideoOff className="h-3 w-3 md:h-3.5 md:w-3.5 text-red-400" />}
                  </div>
                  <span className="text-xs md:text-sm font-bold text-white drop-shadow-md truncate max-w-[100px] md:max-w-[150px]">
                    {displayName} {p.isMe && <span className="text-white/60 text-[10px] md:text-xs font-medium ml-1">(나)</span>}
                  </span>
                </div>

                {!activeSpeakerId && (
                  <div
                    className={`flex items-center gap-1.5 rounded-full px-2 py-1 md:px-3 md:py-1.5 text-[10px] md:text-[11px] font-bold backdrop-blur-md transition-all ${
                      p.isReady
                        ? "bg-blue-500/20 text-blue-300 border border-blue-500/30"
                        : "bg-white/10 text-white/60 border border-white/10"
                    }`}
                  >
                    {p.isReady && <CheckCircle2 className="h-2.5 w-2.5 md:h-3 md:w-3" />}
                    {p.isReady ? "준비 완료" : "준비 중"}
                  </div>
                )}
              </div>
            </motion.div>
          );
        })}
      </AnimatePresence>
    </div>
  );
}
