                  <button onClick={onConfirmStop} className="w-full rounded-2xl bg-red-50 py-3.5 text-sm font-bold text-red-500 hover:bg-red-100/60 transition-colors">
                    네, 촬영 종료하고 대시보드로 돌아가기
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}
    </>
  );
}
