  --theme-navy: #95B1EE;
  --theme-navy-dark: #b8cff8;
  --theme-brand-soft: #364C84;
  --theme-brand-accent: #2e3b1c;
  --theme-muted: #94a3b8;
  --theme-chip: #1e293b;
  --theme-line: #334155;

  --theme-surface: #1e293b;
  --theme-surface-glass: rgba(30, 41, 59, 0.7);
  --theme-border-glass: rgba(255, 255, 255, 0.05);
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
