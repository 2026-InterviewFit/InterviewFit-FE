<file path="app/globals.css">
@import "tailwindcss";

/* 💡 Tailwind v4에서 다크모드를 수동 스위치(.dark 클래스)로 작동하게 만드는 필수 설정! */
@custom-variant dark (&:where(.dark, .dark *));

@theme {
  /* :root와 .dark에서 정의한 색상을 Tailwind가 가져다 씁니다 */
  --color-bg: var(--theme-bg);
  --color-ink: var(--theme-ink);
  --color-navy: var(--theme-navy);
  --color-navy-dark: var(--theme-navy-dark);
  --color-muted: var(--theme-muted);
  --color-chip: var(--theme-chip);
  --color-line: var(--theme-line);
  
  --font-sans: var(--font-satoshi), system-ui, sans-serif;
  --font-serif: var(--font-playfair), Georgia, serif;
}

/* 🌞 기본 (라이트 모드) 색상 */
:root {
  --theme-bg: #f5f5f3;
  --theme-ink: #171717;
  --theme-navy: #1f2c46;
  --theme-navy-dark: #0f1729;
  --theme-muted: #737373;
  --theme-chip: #eceff3;
  --theme-line: #e5e5e3;
}

/* 🌙 심야 (다크 모드) 색상 */
.dark {
  --theme-bg: #0f1729;         /* 짙은 네이비 배경 */
  --theme-ink: #f8fafc;        /* 밝은 텍스트 */
  --theme-navy: #60a5fa;       /* 포인트 컬러는 밝은 블루로 반전 */
  --theme-navy-dark: #93c5fd;  
  --theme-muted: #94a3b8;      /* 회색 텍스트 */
  --theme-chip: #1e293b;       /* 칩/버튼 배경 */
  --theme-line: #334155;       /* 테두리 색상 */
}

html {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  scroll-behavior: smooth;
}

body {
  background-color: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
  /* 💡 배경색과 글자색이 바뀔 때 뚝 끊기지 않고 스르륵~ 부드럽게 변하도록 전환 효과 추가 */
  transition: background-color 0.3s ease, color 0.3s ease; 
}
