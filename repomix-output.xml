            {/* 레이더 차트 & 발표 역량 분석 */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-8 pt-2">
              <div className="flex flex-col items-center border-r-0 lg:border-r border-line/50 dark:border-white/10 pr-0 lg:pr-8">
