// components/practice/AnalysisProgress.tsx
"use client";

import { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { CheckCircle2, AlertCircle, Lightbulb } from "lucide-react";
import type { JobRole } from "@/types";

const LOADING_TIPS = [
  { category: "💡 면접 꿀팁", text: "답변을 하다가 막힐 때는 1~2초간 천천히 숨을 고르고 '잠시 생각할 시간을 주시겠습니까?'라고 정중히 양해를 구해보세요." },
  { category: "👔 면접 복장 추천", text: "IT/개발 직군은 너무 딱딱한 정장보다 깔끔한 셔츠나 슬랙스, 단정한 니트 레이어드가 훨씬 세련되고 전문적인 인상을 줍니다." },
  { category: "🗣️ 면접 멘트 추천", text: "협업 갈등을 묻는 질문에는 '제 의견이 옳다'보다는 '팀의 목표를 위해 어떤 조율 과정을 거쳤는지' STAR 구조로 풀어내는 것이 핵심입니다." },
  { category: "💻 개발일화", text: "인터뷰핏의 AI 엔진은 은재님 팀이 새벽에 마시는 커피의 양과 정비례해서 고도화되고 있다는 소문이 있습니다...☕" },
  { category: "💡 실시간 채용 정보", text: "최근 테크 기업들은 단순 기술 나열보다, 하나의 프로젝트라도 깊게 파고들어 직면한 한계를 어떻게 트러블슈팅했는지를 집중적으로 평가합니다." },
];

interface AnalysisProgressProps {
  analysisProgress: number;
  analysisResult: { message?: string } | null;
  analysisError: string;
  selectedJobData?: JobRole;
  onExit: () => void;
}

export default function AnalysisProgress({
  analysisProgress,
  analysisResult,
  analysisError,
  selectedJobData,
  onExit,
}: AnalysisProgressProps) {
  const [tipIdx, setTipIdx] = useState(0);

  useEffect(() => {
    const tipInterval = setInterval(() => {
      setTipIdx((prev) => (prev + 1) % LOADING_TIPS.length);
    }, 6500);
    return () => clearInterval(tipInterval);
  }, []);

  return (
    <div className="flex h-full w-full flex-col items-center justify-center bg-bg text-ink p-8 relative font-sans select-none overflow-hidden">
      
      <div className="absolute inset-0 z-0 pointer-events-none overflow-hidden opacity-60">
        <div className="absolute -top-40 -left-20 h-[650px] w-[650px] rounded-full bg-[#fef08a]/50 blur-[130px]" />
        <div className="absolute top-10 -right-20 h-[750px] w-[750px] rounded-full bg-[#bfdbfe]/60 blur-[150px]" />
        <div className="absolute bottom-[-150px] left-1/4 h-[600px] w-[600px] rounded-full bg-[#e9d5ff]/40 blur-[130px]" />
      </div>

      <div className="relative z-10 flex flex-col items-center max-w-2xl text-center space-y-8 w-full">
        {/* 진행률 원형 */}
        <div className="relative flex items-center justify-center w-28 h-28">
          <div className="absolute inset-0 rounded-full border-4 border-black/[0.04] dark:border-white/[0.04]" />
          {!analysisResult && !analysisError && (
            <div className="absolute inset-0 rounded-full border-4 border-t-blue-500 border-transparent animate-[spin_2s_linear_infinite]" />
          )}
          {analysisResult && <CheckCircle2 className="h-12 w-12 text-emerald-500" />}
          {analysisError && <AlertCircle className="h-12 w-12 text-red-500" />}
          {!analysisResult && !analysisError && (
            <span className="font-serif text-xl font-bold tracking-tight text-navy dark:text-white">
              {analysisProgress}%
            </span>
          )}
        </div>

        <div className="space-y-2">
          <h2 className="text-2xl font-bold tracking-tight text-navy dark:text-white">
            {analysisResult
              ? "분석 완료!"
              : analysisError
              ? "오류가 발생했습니다"
              : "AI 면접 영상 분석 중..."}
          </h2>
          <p className="text-sm text-muted dark:text-gray-400">
            <span className="font-bold text-navy dark:text-gray-200">{selectedJobData?.name}</span>{" "}
            {analysisResult
              ? "직무 면접 영상 분석이 완료되었습니다."
              : "직무 기준으로 AI가 다각도로 분석을 진행하고 있습니다."}
          </p>
        </div>

        {/* 로딩 팁 */}
        {!analysisResult && !analysisError && (
          <div className="w-full bg-white/70 dark:bg-[#1e293b]/70 border border-black/[0.04] dark:border-white/[0.04] backdrop-blur-md rounded-[32px] p-8 text-center min-h-[160px] flex flex-col items-center justify-center overflow-hidden shadow-sm">
            
            {/* 💡 빙글빙글 도는 로딩 제거하고, 차분한 전구 아이콘과 텍스트로 대체! */}
            <div className="mb-4 flex items-center justify-center gap-1.5 text-blue-500 dark:text-blue-400 opacity-80">
              <Lightbulb className="h-5 w-5" />
              <span className="text-xs font-bold tracking-widest uppercase">Take a break</span>
            </div>

            <AnimatePresence mode="wait">
              <motion.div
                key={tipIdx}
                initial={{ opacity: 0, y: 12 }}
                animate={{ opacity: 1, y: 0 }}
                exit={{ opacity: 0, y: -12 }}
                transition={{ duration: 0.6 }}
                className="flex flex-col items-center space-y-3"
              >
                <span className="inline-block text-xs font-bold text-blue-600 bg-blue-50 dark:text-blue-300 dark:bg-blue-900/30 px-3 py-1 rounded-full">
                  {LOADING_TIPS[tipIdx].category}
                </span>
                <p className="text-sm font-semibold leading-relaxed text-navy dark:text-gray-200 max-w-md break-keep">
                  {LOADING_TIPS[tipIdx].text}
                </p>
              </motion.div>
            </AnimatePresence>
          </div>
        )}

        {/* 💡 업로드 완료가 아닌 '분석 완료' 카드! */}
        {analysisResult && (
          <div className="w-full rounded-[32px] bg-white/80 dark:bg-[#1e293b]/80 p-8 text-left shadow-sm border border-black/[0.04] dark:border-white/[0.04] backdrop-blur-md animate-in fade-in zoom-in-95 duration-500">
            <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
              <div className="rounded-2xl bg-blue-50 dark:bg-blue-900/20 p-5 border border-blue-100/50 dark:border-blue-800/50">
                <p className="text-xs font-bold text-blue-600 dark:text-blue-400">시선 및 표정 분석</p>
                <p className="mt-2 text-sm font-bold text-navy dark:text-white">AI 분석 완료</p>
              </div>
              <div className="rounded-2xl bg-emerald-50 dark:bg-emerald-900/20 p-5 border border-emerald-100/50 dark:border-emerald-800/50">
                <p className="text-xs font-bold text-emerald-600 dark:text-emerald-400">자세 안정성 분석</p>
                <p className="mt-2 text-sm font-bold text-navy dark:text-white">AI 분석 완료</p>
              </div>
              <div className="rounded-2xl bg-purple-50 dark:bg-purple-900/20 p-5 border border-purple-100/50 dark:border-purple-800/50">
                <p className="text-xs font-bold text-purple-600 dark:text-purple-400">발화 및 내용 분석</p>
                <p className="mt-2 text-sm font-bold text-navy dark:text-white">AI 분석 완료</p>
              </div>
            </div>
            <div className="mt-5 rounded-2xl bg-gray-50 dark:bg-slate-800 p-5 border border-black/5 dark:border-white/5">
              <p className="text-xs font-bold text-gray-500">안내</p>
              <p className="mt-2 text-sm font-semibold leading-relaxed text-navy dark:text-gray-200">
                {analysisResult.message}
              </p>
            </div>
          </div>
        )}

        {/* 에러 */}
        {analysisError && (
          <div className="w-full rounded-[28px] border border-red-100 bg-red-50 p-6 text-left text-sm font-semibold leading-relaxed text-red-600">
            {analysisError}
          </div>
        )}

        {/* 버튼이 '분석 완료' 시퀀스 이후에만 더 눈에 띄게! */}
        <button
          onClick={onExit}
          className={`rounded-full px-10 py-4 text-sm font-bold shadow-lg transition-all duration-300 ${
            analysisResult 
              ? "bg-navy dark:bg-white text-white dark:text-navy hover:scale-105" 
              : "bg-gray-200 text-gray-500 hover:bg-gray-300"
          }`}
        >
          대시보드에서 결과 확인하기
        </button>
      </div>
    </div>
  );
}
</file>

<file path="components/practice/RecordingControls.tsx">
"use client";

import { motion } from "framer-motion";
import {
  ChevronRight,
  Loader2,
  Mic,
  Square,
} from "lucide-react";

import type { QuestionMode } from "@/store/useInterviewStore";


interface RecordingControlsProps {
  step: string;
  time: number;
  currentQuestionIdx: number;
  totalQuestions: number;
  questionMode: QuestionMode;
  isProcessingAnswer: boolean;
  onStartCountdown: () => void;
  onStopRecording: () => void;
  onNextQuestion: () => void;
}


export default function RecordingControls({
  step,
  time,
  currentQuestionIdx,
  totalQuestions,
  questionMode,
  isProcessingAnswer,
  onStartCountdown,
  onStopRecording,
  onNextQuestion,
}: RecordingControlsProps) {
  const formatTime =
    (seconds: number) => {
      return `${Math.floor(seconds / 60)
        .toString()
        .padStart(2, "0")}:${(
        seconds % 60
      )
        .toString()
        .padStart(2, "0")}`;
    };


  if (
    step === "confirmStop" ||
    step === "countdown"
  ) {
    return null;
  }


  const isLastBaseQuestion =
    currentQuestionIdx ===
    totalQuestions - 1;


  const answerButtonLabel =
    isProcessingAnswer
      ? questionMode === "base"
        ? "답변 분석 중..."
        : "답변 처리 중..."
      : questionMode === "base"
        ? "답변 완료"
        : isLastBaseQuestion
          ? "꼬리답변 완료 (면접 종료)"
          : "꼬리답변 완료 (다음 질문)";


  return (
    <div className="flex items-center gap-4">
      {step === "prepare" ? (
        <button
          onClick={onStartCountdown}
          className="rounded-full bg-blue-600 px-10 py-4 text-base font-bold text-white shadow-[0_8px_30px_rgba(37,99,235,0.4)] transition-transform hover:scale-105"
        >
          자세 정렬 완료 (촬영 시작)
        </button>
      ) : (
        <>
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="flex items-center gap-6 rounded-full border border-white/10 bg-black/75 px-6 py-3.5 backdrop-blur-md"
          >
            <div className="flex items-center gap-2.5">
              <Mic className="h-4 w-4 text-white/60" />

              <div className="flex h-3 items-end gap-0.5">
                <motion.div
                  animate={{
                    height: [
                      "30%",
                      "100%",
                      "30%",
                    ],
                  }}
                  transition={{
                    repeat: Infinity,
                    duration: 0.8,
                  }}
                  className="w-1 rounded-full bg-emerald-400"
                />

                <motion.div
                  animate={{
                    height: [
                      "70%",
                      "40%",
                      "90%",
                    ],
                  }}
                  transition={{
                    repeat: Infinity,
                    duration: 0.5,
                  }}
                  className="w-1 rounded-full bg-emerald-400"
                />

                <motion.div
                  animate={{
                    height: [
                      "40%",
                      "80%",
                      "50%",
                    ],
                  }}
                  transition={{
                    repeat: Infinity,
                    duration: 0.6,
                  }}
                  className="w-1 rounded-full bg-emerald-400"
                />
              </div>
            </div>


            <div className="h-6 w-px bg-white/20" />


            <div className="flex items-center gap-2">
              <div className="h-2 w-2 animate-pulse rounded-full bg-red-500" />

              <span className="font-mono text-lg font-medium tracking-widest text-white">
                {formatTime(time)}
              </span>
            </div>


            <div className="h-6 w-px bg-white/20" />


            <button
              onClick={onStopRecording}
              disabled={isProcessingAnswer}
              className="flex items-center gap-1.5 text-xs font-bold text-red-400 transition-colors hover:text-red-300 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <Square className="h-3 w-3 fill-current" />
              연습 중단
            </button>
          </motion.div>


          <motion.button
            initial={{
              opacity: 0,
              x: 10,
            }}
            animate={{
              opacity: 1,
              x: 0,
            }}
            onClick={onNextQuestion}
            disabled={
              isProcessingAnswer ||
              step !== "recording"
            }
            className="flex items-center gap-1.5 rounded-full bg-white px-6 py-3.5 text-sm font-bold text-navy shadow-xl transition-colors hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {isProcessingAnswer && (
              <Loader2 className="h-4 w-4 animate-spin" />
            )}

            <span>
              {answerButtonLabel}
            </span>

            {!isProcessingAnswer && (
              <ChevronRight className="h-4 w-4" />
            )}
          </motion.button>
        </>
      )}
    </div>
  );
}
</file>

<file path="hooks/useCounter.ts">
import { useEffect, useState } from "react";

interface UseCounterOptions {
  target: number;
  duration?: number;
  delay?: number;
  decimals?: number;
}

export function useCounter({
  target,
  duration = 1800,
  delay = 0,
  decimals = 0,
}: UseCounterOptions) {
  const [value, setValue] = useState(0);

  useEffect(() => {
    let frameId: number;
    let startTime: number | null = null;

    const timeoutId = setTimeout(() => {
      const animate = (timestamp: number) => {
        if (startTime === null) startTime = timestamp;
        const elapsed = timestamp - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        setValue(target * eased);

        if (progress < 1) {
          frameId = requestAnimationFrame(animate);
        } else {
          setValue(target);
        }
      };

      frameId = requestAnimationFrame(animate);
    }, delay);

    return () => {
      clearTimeout(timeoutId);
      if (frameId) cancelAnimationFrame(frameId);
    };
  }, [target, duration, delay]);

  return decimals > 0
    ? value.toFixed(decimals)
    : Math.floor(value).toLocaleString();
}
</file>

<file path="hooks/useGroupAnswerRecording.ts">
"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import type { LocalParticipant } from "livekit-client";
import { Track } from "livekit-client";
import { uploadGroupAnswerVideo } from "@/lib/groupInterviewApi";
import { fixWebmBlobDuration, getSupportedWebmMimeType } from "@/lib/mediaRecorder";
import type { GroupInterviewEvent, GroupInterviewProgress } from "@/types/groupInterview";

export interface GroupVideoUploadStatus {
  answerId: number;
  status: "uploading" | "failed";
  error?: string;
}

interface UseGroupAnswerRecordingOptions {
  roomId: string;
  myUserId: string;
  localParticipant: LocalParticipant;
  progress: GroupInterviewProgress | null;
  lastEvent: GroupInterviewEvent | null;
}

interface AnswerRecordingContext {
  answerId: number;
  participantUserId: string;
  serverStartedAt: string | null;
  startedAtMs: number;
}

interface AnswerContextInput {
  answerId: number | null | undefined;
  participantUserId: number | string | null | undefined;
  serverStartedAt: string | null | undefined;
}

export function useGroupAnswerRecording({
  roomId,
  myUserId,
  localParticipant,
  progress,
  lastEvent,
}: UseGroupAnswerRecordingOptions) {
  const recorderRef = useRef<MediaRecorder | null>(null);
  const currentAnswerContextRef = useRef<AnswerContextInput | null>(null);
  const recordingContextRef = useRef<AnswerRecordingContext | null>(null);
  const isStoppingRef = useRef(false);
  const stopPromiseRef = useRef<Promise<AnswerRecordingContext | null> | null>(null);
  const resolveStopRef = useRef<((context: AnswerRecordingContext | null) => void) | null>(null);
  const timedOutAnswerIdsRef = useRef(new Set<number>());
  const uploadedAnswerIdsRef = useRef(new Set<number>());
  const uploadingAnswerIdsRef = useRef(new Set<number>());
  const pendingUploadBlobsRef = useRef(new Map<number, Blob>());
  const mountedRef = useRef(true);
  const [uploadStatuses, setUploadStatuses] = useState<GroupVideoUploadStatus[]>([]);
  const [recordingError, setRecordingError] = useState("");

  const setUploadStatus = useCallback((next: GroupVideoUploadStatus | null, answerId: number) => {
    if (!mountedRef.current) return;
    setUploadStatuses((statuses) => {
      const withoutCurrent = statuses.filter((item) => item.answerId !== answerId);
      return next ? [...withoutCurrent, next] : withoutCurrent;
    });
  }, []);

  const uploadVideo = useCallback(async (answerId: number, blob: Blob) => {
    if (uploadedAnswerIdsRef.current.has(answerId) || uploadingAnswerIdsRef.current.has(answerId)) return;

    pendingUploadBlobsRef.current.set(answerId, blob);
    uploadingAnswerIdsRef.current.add(answerId);
    setUploadStatus({ answerId, status: "uploading" }, answerId);

    try {
      await uploadGroupAnswerVideo(roomId, answerId, blob);
      uploadedAnswerIdsRef.current.add(answerId);
      pendingUploadBlobsRef.current.delete(answerId);
      setUploadStatus(null, answerId);
    } catch (cause) {
      const message = cause instanceof Error ? cause.message : "답변 영상 업로드에 실패했습니다.";
      console.error(`그룹 답변 영상 업로드 실패 (answerId: ${answerId})`, cause);
      setUploadStatus({ answerId, status: "failed", error: message }, answerId);
    } finally {
      uploadingAnswerIdsRef.current.delete(answerId);
    }
  }, [roomId, setUploadStatus]);

  const rememberAnswerContext = useCallback((context: AnswerContextInput) => {
    if (typeof context.answerId === "number" && Number.isFinite(context.answerId)) {
      currentAnswerContextRef.current = context;
    }
  }, []);

  const stopRecording = useCallback((): Promise<AnswerRecordingContext | null> => {
    const recorder = recorderRef.current;
    if (!recorder || recorder.state === "inactive") return Promise.resolve(null);
    if (isStoppingRef.current) return stopPromiseRef.current ?? Promise.resolve(null);

    isStoppingRef.current = true;
    stopPromiseRef.current = new Promise((resolve) => {
      resolveStopRef.current = resolve;
    });
    try {
      recorder.stop();
    } catch (cause) {
      isStoppingRef.current = false;
      resolveStopRef.current?.(null);
      resolveStopRef.current = null;
      console.error("그룹 답변 녹화 종료 실패", cause);
      if (mountedRef.current) setRecordingError("답변 녹화를 종료하지 못했습니다.");
    }
    return stopPromiseRef.current;
  }, []);

  const startRecording = useCallback((input: AnswerContextInput) => {
    if (recorderRef.current || isStoppingRef.current) return;
    if (typeof input.answerId !== "number") return;

    const recordingContext: AnswerRecordingContext = {
      answerId: input.answerId,
      participantUserId: String(input.participantUserId ?? ""),
      serverStartedAt: input.serverStartedAt ?? null,
      startedAtMs: Date.now(),
    };

    const cameraTrack = localParticipant.getTrackPublication(Track.Source.Camera)?.track?.mediaStreamTrack;
    const microphoneTrack = localParticipant.getTrackPublication(Track.Source.Microphone)?.track?.mediaStreamTrack;
    if (!cameraTrack && !microphoneTrack) {
      setRecordingError("녹화할 카메라 또는 마이크 트랙이 없습니다.");
      return;
    }

    const stream = new MediaStream(
      [cameraTrack, microphoneTrack].filter((track): track is MediaStreamTrack => Boolean(track)),
    );
    const chunks: Blob[] = [];

    try {
      const mimeType = getSupportedWebmMimeType();
      const recorder = new MediaRecorder(stream, { mimeType });
      recorder.ondataavailable = (event) => {
        if (event.data.size > 0) chunks.push(event.data);
      };
      recorder.onstop = () => {
        const stoppedContext = recordingContextRef.current ?? recordingContext;
        const rawBlob = new Blob(chunks, { type: recorder.mimeType || "video/webm" });

        recorderRef.current = null;
        recordingContextRef.current = null;
        isStoppingRef.current = false;
        if (currentAnswerContextRef.current?.answerId === stoppedContext.answerId) {
          currentAnswerContextRef.current = null;
        }

        if (rawBlob.size === 0) {
          console.error(`그룹 답변 영상이 비어 있습니다. (answerId: ${stoppedContext.answerId})`);
          if (mountedRef.current) setRecordingError("녹화된 답변 영상이 비어 있어 업로드하지 못했습니다.");
        } else {
          // progress가 이미 다음 답변자로 바뀌었더라도 녹화 시작 시 고정한 answerId를 사용한다.
          pendingUploadBlobsRef.current.set(stoppedContext.answerId, rawBlob);
          const durationMs = Math.max(1, Date.now() - stoppedContext.startedAtMs);
          void fixWebmBlobDuration(rawBlob, durationMs)
            .catch((cause) => {
              console.error(`그룹 답변 영상 길이 보정 실패 (answerId: ${stoppedContext.answerId})`, cause);
              return rawBlob;
            })
            .then((blob) => uploadVideo(stoppedContext.answerId, blob));
        }
        resolveStopRef.current?.(stoppedContext);
        resolveStopRef.current = null;
        stopPromiseRef.current = null;
      };
      recorder.onerror = (event) => {
        console.error("그룹 답변 녹화 오류", event);
        if (mountedRef.current) setRecordingError("답변 녹화 중 오류가 발생했습니다.");
      };

      currentAnswerContextRef.current = input;
      recordingContextRef.current = recordingContext;
      recorderRef.current = recorder;
      setRecordingError("");
      recorder.start(1000);
    } catch (cause) {
      recorderRef.current = null;
      recordingContextRef.current = null;
      if (currentAnswerContextRef.current?.answerId === input.answerId) {
        currentAnswerContextRef.current = null;
      }
      isStoppingRef.current = false;
      console.error("그룹 답변 녹화 시작 실패", cause);
      setRecordingError("답변 녹화를 시작하지 못했습니다.");
    }
  }, [localParticipant, uploadVideo]);

  const stopRecordingForAnswer = useCallback((answerId: number) => {
    const recorder = recorderRef.current;
    const context = recordingContextRef.current;
    if (
      !Number.isFinite(answerId)
      || !recorder
      || recorder.state !== "recording"
      || !context
      || context.answerId !== answerId
    ) {
      if (mountedRef.current) {
        setRecordingError("현재 답변 녹화가 시작되지 않아 답변을 완료할 수 없습니다.");
      }
      return Promise.resolve(null);
    }
    return stopRecording();
  }, [stopRecording]);

  useEffect(() => {
    const eventAnswerId = lastEvent?.progress?.answerId ?? lastEvent?.answerId;
    if (
      lastEvent?.type === "ANSWER_STARTED"
      && String(lastEvent.progress?.currentParticipantUserId ?? "") === myUserId
    ) {
      rememberAnswerContext({
        answerId: eventAnswerId,
        participantUserId: lastEvent.progress?.currentParticipantUserId,
        serverStartedAt: lastEvent.progress?.answerStartedAt,
      });
    }
  }, [lastEvent, myUserId, rememberAnswerContext]);

  useEffect(() => {
    const isMyActiveAnswer = progress?.status?.toUpperCase() === "ANSWERING"
      && String(progress.currentParticipantUserId ?? "") === myUserId;

    if (isMyActiveAnswer) {
      const context: AnswerContextInput = {
        answerId: progress?.answerId ?? currentAnswerContextRef.current?.answerId,
        participantUserId: progress?.currentParticipantUserId,
        serverStartedAt: progress?.answerStartedAt,
      };
      rememberAnswerContext(context);
      startRecording(context);
      return;
    }

    if (recorderRef.current?.state === "recording") void stopRecording();
    else if (!isStoppingRef.current) currentAnswerContextRef.current = null;
  }, [myUserId, progress, rememberAnswerContext, startRecording, stopRecording]);

  useEffect(() => {
    if (!lastEvent?.type.startsWith("ANSWER_TIMED_OUT_")) return;
    // 이 브라우저가 해당 답변을 녹화 중일 때만 종료한다. 진행 API는 호출하지 않는다.
    if (
      recorderRef.current
      && recordingContextRef.current?.participantUserId === myUserId
    ) {
      timedOutAnswerIdsRef.current.add(recordingContextRef.current.answerId);
      void stopRecording();
    }
  }, [lastEvent, myUserId, stopRecording]);

  useEffect(() => {
    const handleBeforeUnload = (event: BeforeUnloadEvent) => {
      const hasUnsentVideo = recorderRef.current != null
        || isStoppingRef.current
        || pendingUploadBlobsRef.current.size > 0
        || uploadingAnswerIdsRef.current.size > 0;
      if (!hasUnsentVideo) return;
      event.preventDefault();
    };
    window.addEventListener("beforeunload", handleBeforeUnload);
    return () => window.removeEventListener("beforeunload", handleBeforeUnload);
  }, []);

  useEffect(() => {
    mountedRef.current = true;
    return () => {
      mountedRef.current = false;
      const recorder = recorderRef.current;
      if (recorder?.state === "recording" && !isStoppingRef.current) {
        isStoppingRef.current = true;
        recorder.stop();
      }
    };
  }, []);

  const retryUpload = useCallback((answerId: number) => {
    const blob = pendingUploadBlobsRef.current.get(answerId);
    if (blob) void uploadVideo(answerId, blob);
  }, [uploadVideo]);

  const wasAnswerTimedOut = useCallback(
    (answerId: number) => timedOutAnswerIdsRef.current.has(answerId),
    [],
  );

  return {
    rememberAnswerContext,
    stopRecording,
    stopRecordingForAnswer,
    uploadStatuses,
    recordingError,
    retryUpload,
    wasAnswerTimedOut,
  };
}
</file>

