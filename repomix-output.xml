const JOB_CATEGORIES = [
  { label: "IT/개발", jobs: ["프론트엔드", "백엔드", "AI", "데이터분석"] },
  { label: "비즈니스", jobs: ["마케팅", "인사", "재무·회계"] },
  { label: "디자인", jobs: ["UX/UI 디자이너", "영상 제작", "그래픽 디자이너"] },
];

export default function JobSettings() {
