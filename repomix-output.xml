                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: i * 0.12, ease: [0.22, 1, 0.36, 1] }}
                className="group flex flex-1 flex-col items-center"
                style={{ maxWidth: 150 }}
              >
                {/* 아바타 + 왕관/메달 */}
